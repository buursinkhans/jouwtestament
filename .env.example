# Copy to .env and fill in. Never commit .env. In production, set these in Netlify (Site settings → Environment variables).

# URL of the submit-lead function (docs/10). Empty = the check does not send leads.
# On Netlify: /api/submit-lead
PUBLIC_LEAD_ENDPOINT=

# Google Sheet lead storage (service account; share the sheet with this email as editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service account JSON, on one line with \n for line breaks
GOOGLE_PRIVATE_KEY=
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# Tab name (row 1 = column headers, see LEAD_COLUMNS in src/components/check/lead.ts)
GOOGLE_SHEET_TAB=Leads
