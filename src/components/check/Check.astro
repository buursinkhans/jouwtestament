---
// Reusable check block (docs/09): on /check, on home (#check) and on every segment page.
// Server-rendered form with real radio inputs; the script adds prefill, validation and results.
// TODO(review-partner): all texts.
import LogoMark from '../layout/LogoMark.astro';
import '../../styles/home-editorial.css';
import ShareCheck from '../content/ShareCheck.astro';

interface Props {
  prefill?: string; // e.g. "?situatie=samenwonend" (docs/03)
  segmentPage?: string; // sent as source.segmentPage
  isPageTitle?: boolean; // H1 on /check, H2 elsewhere
  idPrefix?: string;
}

const { prefill = '', segmentPage = '', isPageTitle = false, idPrefix = 'check' } = Astro.props;
const Heading = isPageTitle ? 'h1' : 'h2';
const id = (name: string) => `${idPrefix}-${name}`;


const questions = [
  {
    key: 'situation',
    legend: 'Wat is je situatie?',
    options: [
      ['married', 'Getrouwd / geregistreerd partner'],
      ['cohabiting', 'Samenwonend, niet getrouwd'],
      ['single', 'Alleenstaand'],
      ['unknown', 'Zeg ik liever niet'],
    ],
  },
  {
    key: 'children',
    legend: 'Heb je kinderen?',
    options: [
      ['joint', 'Ja, samen'],
      ['blended', 'Ja, ook uit een eerdere relatie'],
      ['none', 'Nee'],
      ['unknown', 'Zeg ik liever niet'],
    ],
  },
  {
    key: 'minors',
    legend: 'Is een van je kinderen jonger dan 18?',
    options: [
      ['yes', 'Ja'],
      ['no', 'Nee'],
    ],
    conditional: true,
  },
  {
    key: 'home',
    legend: 'Hoe woon je?',
    options: [
      ['yes', 'Ik heb een koopwoning'],
      ['no', 'Ik huur'],
      ['unknown', 'Anders / weet ik niet'],
    ],
  },
  {
    key: 'documents',
    legend: 'Wat heb je al geregeld?',
    options: [
      ['both', 'Testament én levenstestament'],
      ['will_only', 'Alleen een testament'],
      ['nothing', 'Nog niets'],
      ['unknown', 'Weet ik niet'],
    ],
  },
  {
    key: 'goal',
    legend: 'Wat wil je vooral bereiken?',
    options: [
      ['documents', 'Mijn administratie overzichtelijk maken'],
      ['conversation', 'Met mijn familie praten over later'],
      ['wishes', 'Mijn wensen op papier zetten'],
      ['review', 'Mijn testament of levenstestament laten nakijken'],
      ['help', 'Mijn naasten helpen als er iets gebeurt'],
    ],
    optional: true,
  },
] as const;

---

<section
  class="check editorial-check"
  id={isPageTitle ? undefined : 'check'}
  aria-labelledby={id('title')}
  data-check
  data-check-block
  data-prefill={prefill}
  data-segment-page={segmentPage}
>
  <div class="check-intro">
    <span class="eyebrow">Gratis nalatenschapscheck</span>
    <Heading id={id('title')}>Maak je gespreksagenda</Heading>
    <p class="lead">
      Maak een gespreksagenda met vragen voor thuis en voor de notaris.
    </p>
    <p class="small">Je krijgt praktische suggesties en vragen. De check geeft geen persoonlijk juridisch of financieel advies.</p>
  </div>

  <noscript><p>Voor deze check is JavaScript nodig. Je kunt ook <a href="/voor-wie/je-ouders/">vragen voor een familiegesprek lezen</a>.</p></noscript>
  <form class="check-form" novalidate data-check-form>
    <fieldset class="question" data-check-route>
      <legend>Voor wie bereid je het gesprek voor?</legend>
      <label><input type="radio" name="route" value="self" checked /> Ik wil mijn eigen nalatenschap voorbereiden.</label>
      <label><input type="radio" name="route" value="parents" /> Ik wil het gesprek met mijn ouders beginnen.</label>
    </fieldset>
    <p data-parents-intro hidden>Maak een agenda vanuit jouw rol. Je ouders kiezen zelf wat ze willen bespreken en vastleggen.</p>
    <p data-check-progress aria-live="polite"></p>
    {questions.map((question) => (
      <fieldset
        class="question"
        data-question={question.key}
        data-conditional={'conditional' in question ? 'true' : undefined}
      >
        <legend>
          {question.legend}
          {'optional' in question && <span class="optional"> (optioneel)</span>}
        </legend>
        <div class="pills">
          {question.options.map(([value, label]) => (
            <label class="pill">
              <input
                type="radio"
                name={question.key}
                value={value}
                required={!('optional' in question) && !('conditional' in question)}
              />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <p class="error" hidden data-error-for={question.key}>Kies een antwoord.</p>
      </fieldset>
    ))}

    <div class="step-actions" data-step-actions>
      <button type="button" class="link-button" data-step-back hidden>Terug</button>
      <button type="button" class="btn-primary submit" data-show-result>Volgende</button>
    </div>
    <div class="result" hidden tabindex="-1" data-check-result>
      <h3 data-result-title>Jouw persoonlijke actieoverzicht</h3>
      <div class="action-overview">
        <section><h4>Dit kun je zelf op orde brengen</h4><ul data-overview="practical"></ul></section>
        <section><h4>Dit kun je samen bespreken</h4><ul data-overview="home"></ul></section>
        <section><h4>Dit kun je aan een notaris vragen</h4><ul data-overview="notary"></ul></section>
      </div>
      <section class="agenda" data-agenda aria-labelledby={id('agenda-title')}>
        <div class="agenda-brand"><LogoMark size={24} /> Helder Nalaten</div>
        <h3 id={id('agenda-title')}>Onze gespreksagenda voor later</h3>
        <p>Je hoeft niet alles in één keer te regelen. Begin met de onderwerpen die voor jullie belangrijk zijn. Met deze vragen kun je samen het gesprek aangaan.</p>
        <label class="agenda-field">Datum (optioneel)<input type="text" data-agenda-date maxlength="40" /></label>
        <div data-agenda-edit></div>
        <button type="button" class="link-button" data-agenda-add>Voeg een onderwerp toe</button>
        <label class="agenda-field">Wat willen we nog uitzoeken?<textarea data-agenda-notes rows="3"></textarea></label>
        <fieldset class="agenda-next">
          <legend>Onze volgende stap</legend>
          <label class="agenda-field">Wat willen we als eerste doen?<textarea data-agenda-step rows="2"></textarea></label>
          <label class="agenda-field">Wie gaat dit oppakken?<input type="text" data-agenda-who /></label>
          <label class="agenda-field">Wanneer praten we verder?<input type="text" data-agenda-when /></label>
        </fieldset>
      </section>
      <section class="agenda-print" data-agenda-output hidden></section>
      <div class="btn-row">
        <button type="button" class="btn-primary" data-agenda-copy>Kopieer de agenda</button>
        <button type="button" class="link-button" data-agenda-print>Print de agenda</button>
      </div>
      <p role="status" data-agenda-status></p>
      <button type="button" class="link-button" data-check-reset>Antwoorden aanpassen</button>
      <button type="button" class="link-button" data-check-restart>Opnieuw beginnen</button>
      <section class="check-next-links">
        <h3>Wil je verder?</h3>
        <p data-parents-next hidden>Je ouders kiezen zelf wat ze willen delen en vastleggen. Ze kunnen zelf verder met een adviseur of met de digitale assistent.</p>
        <ul>
          <li><a href="/#invulboek" data-check-book>Lees over het papieren invulboek</a></li>
          <li>‘Mijn woorden voor later’, een gratis schrijfhulp, is in ontwikkeling.</li>
          <li><a href="/regel-het-zelf" data-option-self>Bekijk de digitale voorbereiding</a></li>
          <li><a href="/afspraak" data-option-adviser>Vraag een kennismakingsgesprek aan</a></li>
          <li><a href="/testament/" data-check-notary>Lees over het vervolg bij de notaris</a></li>
        </ul>
      </section>
      <ShareCheck />
    </div>

  </form>

</section>

<script>
  import { initCheck } from './check-flow.ts';
  document.querySelectorAll<HTMLElement>('[data-check]').forEach(initCheck);
</script>

<style>
  .editorial-check { color: var(--home-ink); max-width: 46rem; margin-inline: auto; padding-block: clamp(1.25rem, 4vw, 2.5rem); }
  [hidden] { display: none !important; }
  .check-intro { margin-bottom: 1rem; }
  .check-intro h1, .check-intro h2 { font-family: 'Editorial Lora', Georgia, serif; }
  .question, .agenda { border: 1px solid #a8b9b5; border-radius: 12px; background: white; padding: 1rem; }
  .question legend, .agenda-next legend { font-weight: 700; }
  .question label { display: flex; align-items: center; gap: .65rem; min-height: 48px; margin-block: .2rem; cursor: pointer; }
  .question label:has(input:checked) { background: #f7e9e6; border-radius: 6px; }
  .question input { accent-color: var(--home-accent); flex: none; }
  .step-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem; margin-block: 1rem; }
  .step-actions .submit { margin-inline-start: auto; }
  .editorial-check .btn-primary { background: var(--home-accent); color: white; border-color: var(--home-accent); min-height: 48px; border-radius: 8px; }
  .editorial-check .btn-primary:hover { background: #763027; }
  .editorial-check :is(a, button, input, textarea):focus-visible { outline: 3px solid #183b40; outline-offset: 3px; }
  .error { color: #98382e; }
  .link-button { text-decoration: underline; color: #183b40; min-height: 44px; cursor: pointer; padding: .35rem .15rem; }
  .action-overview { display: grid; gap: .8rem; margin-block: 1rem; }
  .action-overview section, .check-next-links { background: #e9f1ef; border-radius: 10px; padding: .85rem 1rem; }
  .action-overview ul, .check-next-links ul { padding-inline-start: 1.2rem; }
  .agenda { margin-block: 1rem; }
  .agenda-brand { display: flex; align-items: center; gap: .5rem; font-weight: 700; }
  .agenda-field { display: grid; gap: .3rem; margin-block: .65rem; font-weight: 650; }
  .agenda-field :is(input, textarea), .agenda :global(.agenda-input) { display: block; width: 100%; border: 1px solid #738c85; border-radius: 6px; padding: .5rem; }
  .agenda :global(.agenda-row) { margin-block: .6rem; }
  .agenda :global(.agenda-row label) { display: block; font-weight: 650; }
  .agenda :global(.agenda-row button) { min-height: 44px; text-decoration: underline; cursor: pointer; }
  .agenda-next { margin-top: 1rem; }
  .check-next-links { margin-block: 1rem; }
  .agenda-print { display: none; white-space: pre-wrap; overflow-wrap: anywhere; }
  @media print {
    @page { size: A4; margin: 14mm; }
    :global(body:has(.agenda-print.printing) :not(:has(.agenda-print.printing), .agenda-print.printing, .agenda-print.printing *)) { display: none !important; }
    .agenda-print.printing { display: block; color: #000; font: 11pt/1.35 Georgia, serif; }
    .agenda-print :global(.agenda-print-brand) { display: flex; align-items: center; gap: .5rem; margin-bottom: .5rem; }
  }
</style>
