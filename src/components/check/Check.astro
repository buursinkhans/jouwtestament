---
// Reusable check block (docs/09): on /check, on home (#check) and on every segment page.
// Server-rendered form with real radio inputs; the script adds prefill, validation and results.
// TODO(review-partner): all texts.
import { pricing, euro } from '../../config/pricing';
import { devOnly } from '../../config/site';

interface Props {
  prefill?: string; // e.g. "?situatie=samenwonend" (docs/03)
  segmentPage?: string; // sent as source.segmentPage
  isPageTitle?: boolean; // H1 on /check, H2 elsewhere
  idPrefix?: string;
}

const { prefill = '', segmentPage = '', isPageTitle = false, idPrefix = 'check' } = Astro.props;
const Heading = isPageTitle ? 'h1' : 'h2';
const id = (name: string) => `${idPrefix}-${name}`;

// Lead endpoint (docs/10: serverless function). Empty = not connected yet.
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '';

const questions = [
  {
    key: 'situation',
    legend: 'Wat is je situatie?',
    options: [
      ['married', 'Getrouwd / geregistreerd partner'],
      ['cohabiting', 'Samenwonend, niet getrouwd'],
      ['single', 'Alleenstaand'],
    ],
  },
  {
    key: 'children',
    legend: 'Heb je kinderen?',
    options: [
      ['joint', 'Ja, samen'],
      ['blended', 'Ja, ook uit een eerdere relatie'],
      ['none', 'Nee'],
    ],
  },
  {
    key: 'minors',
    legend: 'Is een van je kinderen jonger dan 18?',
    options: [
      ['yes', 'Ja'],
      ['no', 'Nee'],
    ],
    conditional: true,
  },
  {
    key: 'home',
    legend: 'Heb je een koopwoning?',
    options: [
      ['yes', 'Ja'],
      ['no', 'Nee'],
    ],
  },
  {
    key: 'documents',
    legend: 'Wat heb je al geregeld?',
    options: [
      ['both', 'Testament én levenstestament'],
      ['will_only', 'Alleen een testament'],
      ['nothing', 'Nog niets'],
      ['unknown', 'Weet ik niet'],
    ],
  },
  {
    key: 'notary',
    legend: 'Heb je al een notaris?',
    options: [
      ['network', 'Nee, graag via jullie netwerk'],
      ['own', 'Ja, mijn eigen notaris'],
      ['unknown', 'Weet ik nog niet'],
    ],
    optional: true,
  },
] as const;

const consentText =
  'Ik ga akkoord dat mijn antwoorden en contactgegevens worden gedeeld met een adviseur van Helder Nalaten om contact met mij op te nemen.';
const selfPrice = euro(pricing.selfService);
const adviceFrom = euro(pricing.advice.min);
---

<section
  class="check"
  id={isPageTitle ? undefined : 'check'}
  aria-labelledby={id('title')}
  data-check
  data-check-block
  data-prefill={prefill}
  data-segment-page={segmentPage}
  data-endpoint={endpoint}
  data-consent-text={consentText}
>
  <div class="check-intro">
    <span class="eyebrow">Gratis nalatenschapscheck</span>
    <Heading id={id('title')}>Hoe staat jouw regeling ervoor?</Heading>
    <p class="lead">
      Beantwoord een paar vragen en zie direct waar je op moet letten. Daarna kies je: zelf regelen met onze
      assistent, of een gesprek met een adviseur.
    </p>
    <p class="small">De check geeft een eerste indicatie en is geen juridisch of financieel advies.</p>
  </div>

  <form class="check-form" method="post" action={endpoint || '/api/submit-lead'} novalidate data-check-form>
    {questions.map((question, index) => (
      <fieldset
        class="question"
        data-question={question.key}
        data-conditional={'conditional' in question ? 'true' : undefined}
      >
        <legend>
          <span class="q-number">{'conditional' in question ? `${index}b` : index < 2 ? index + 1 : index}.</span>
          {question.legend}
          {'optional' in question && <span class="optional"> (optioneel)</span>}
        </legend>
        <div class="pills">
          {question.options.map(([value, label]) => (
            <label class="pill">
              <input
                type="radio"
                name={question.key}
                value={value}
                required={!('optional' in question) && !('conditional' in question)}
              />
              <span>{label}</span>
            </label>
          ))}
        </div>
        <p class="error" hidden data-error-for={question.key}>Kies een antwoord.</p>
      </fieldset>
    ))}

    <div class="step-actions" data-step-actions>
      <p class="form-error error" hidden data-form-error role="alert">
        Niet alle vragen zijn ingevuld. Kijk de gemarkeerde vragen na.
      </p>
      <button type="button" class="btn-primary submit" data-show-result>Bekijk mijn aandachtspunten</button>
    </div>

    <div class="result" hidden tabindex="-1" data-check-result>
      <h3>Jouw aandachtspunten</h3>
      <ul class="flags" data-flag-list></ul>

      <h3>Wat wil je nu doen?</h3>
      <div class="options">
        <div class="option">
          <h4>Regel het zelf met onze assistent</h4>
          <p>
            Onze digitale assistent stelt je de vragen en zet je wensen op een rij. Je krijgt een instructie voor de
            notaris en een uitleg voor je nabestaanden.
          </p>
          <p class="option-price">{selfPrice}</p>
          <button type="button" class="btn-primary" data-option-self>Start met de assistent</button>
        </div>
        <div class="option" data-option-adviser-card>
          <span class="recommended" hidden data-recommended>Aanbevolen voor jouw situatie</span>
          <h4>Afspraak met een adviseur</h4>
          <p>
            Voor een ingewikkelde situatie, of als je het liever niet zelf doet. Een adviseur neemt binnen twee
            werkdagen contact op.
          </p>
          <p class="option-price">Advies vanaf {adviceFrom}</p>
          <button type="button" class="btn-secondary" data-option-adviser>Kies een adviseur</button>
        </div>
      </div>
      <button type="button" class="link-button" data-check-reset>Antwoorden aanpassen</button>
    </div>

    <fieldset class="contact" id="adviseur" data-contact>
      <legend>Waar mag de adviseur je bereiken?</legend>
      <div class="field">
        <label for={id('name')}>Naam</label>
        <input id={id('name')} name="name" type="text" autocomplete="name" required minlength="2" />
        <p class="error" hidden data-error-for="name">Vul je naam in.</p>
      </div>
      <div class="field">
        <label for={id('email')}>E-mailadres</label>
        <input id={id('email')} name="email" type="email" autocomplete="email" required />
        <p class="error" hidden data-error-for="email">Vul een geldig e-mailadres in.</p>
      </div>
      <div class="field">
        <label for={id('phone')}>Telefoonnummer <span class="optional">(optioneel)</span></label>
        <input id={id('phone')} name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        <p class="error" hidden data-error-for="phone">Vul een Nederlands telefoonnummer in, bijvoorbeeld 06 12345678.</p>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label for={id('company_website')}>Laat dit veld leeg</label>
        <input id={id('company_website')} name="company_website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <label class="consent">
        <input type="checkbox" name="consent" value="yes" required />
        <span>{consentText} <a href="/privacy">Privacyverklaring</a></span>
      </label>
      <p class="error" hidden data-error-for="consent">Geef toestemming om verder te gaan.</p>
    </fieldset>

    <input type="hidden" name="consentText" value={consentText} />
    <input type="hidden" name="landingPage" value={Astro.url.pathname} />
    <input type="hidden" name="segmentPage" value={segmentPage} />

    <p class="contact-error error" hidden data-contact-error role="alert">Controleer de gemarkeerde velden.</p>
    <button type="submit" class="btn-primary submit" data-contact-submit>Vraag een gesprek aan</button>
  </form>

  <div class="sent" hidden tabindex="-1" data-sent>
    <div class="thanks" data-thanks hidden>
      <p><strong>Bedankt!</strong> Een adviseur neemt binnen twee werkdagen contact met je op om dit samen door te lopen.</p>
    </div>
    <div class="dev-notice" data-not-connected hidden>
      {
        devOnly ? (
          <p>
            <span class="placeholder">[LEAD-OPSLAG NOG NIET GEKOPPELD]</span> Je gegevens zijn niet verstuurd. Zie
            .env.example (<code>PUBLIC_LEAD_ENDPOINT</code>).
          </p>
        ) : (
          // TODO(owner): factual status message while lead storage is not connected
          <p>
            Let op: we nemen op dit moment nog geen aanvragen aan. Je gegevens zijn niet verstuurd of opgeslagen.
          </p>
        )
      }
    </div>
    <div class="send-failed" data-send-failed hidden role="alert">
      <p>Het versturen is niet gelukt. Probeer het later nog eens.</p>
    </div>
  </div>
</section>

<script>
  import { getFlags, flagContent } from './getFlags.ts';
  import { prefill } from './prefill.ts';
  import { getSegment } from './getSegment.ts';
  import { getScore, getPriority } from './score.ts';
  import { track } from '../../lib/analytics';
  import type { Answers } from './types.ts';

  const phonePattern = /^(\+31|0031|0)[1-9]\d{8}$/;
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLElement>('[data-check]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-check-form]')!;
    const result = root.querySelector<HTMLElement>('[data-check-result]')!;
    const flagList = root.querySelector<HTMLElement>('[data-flag-list]')!;
    const formError = root.querySelector<HTMLElement>('[data-form-error]')!;
    const minorsQuestion = root.querySelector<HTMLElement>('[data-question="minors"]')!;
    const pageParams = new URLSearchParams(window.location.search);

    const value = (name: string) =>
      (form.elements.namedItem(name) as RadioNodeList | HTMLInputElement | null)?.value ?? '';

    // Question 2b only when question 2 ≠ "none"
    const updateMinors = () => {
      const hide = value('children') === 'none';
      minorsQuestion.hidden = hide;
      if (hide) minorsQuestion.querySelectorAll('input').forEach((input) => (input.checked = false));
    };

    // Prefill: component prop first, then URL parameters of the page
    const prefilled = {
      ...prefill(new URLSearchParams(root.dataset.prefill ?? '')),
      ...prefill(pageParams),
    };
    for (const [key, val] of Object.entries(prefilled)) {
      const input = form.querySelector<HTMLInputElement>(`input[name="${key}"][value="${val}"]`);
      if (input) input.checked = true;
    }
    updateMinors();
    // Analytics: progress only, never the chosen answers (docs/09 §8)
    let started = false;
    const answered = new Set<string>();
    const questionKeys = ['situation', 'children', 'minors', 'home', 'documents', 'notary'];
    form.addEventListener('change', (event) => {
      const changed = (event.target as HTMLInputElement).name;
      if (!started) {
        started = true;
        track('check_started');
      }
      if (questionKeys.includes(changed) && !answered.has(changed)) {
        answered.add(changed);
        track('check_question_answered', { question: changed });
      }
      if (changed === 'children') updateMinors();
      const name = (event.target as HTMLInputElement).name;
      root.querySelector<HTMLElement>(`[data-error-for="${name}"]`)?.setAttribute('hidden', '');
    });

    const showError = (name: string, show: boolean) => {
      const error = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (error) error.hidden = !show;
      const field = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      if (field && field.type !== 'radio') field.setAttribute('aria-invalid', String(show));
      return show;
    };

    const stepActions = root.querySelector<HTMLElement>('[data-step-actions]')!;
    const contact = root.querySelector<HTMLElement>('[data-contact]')!;
    const contactSubmit = root.querySelector<HTMLElement>('[data-contact-submit]')!;
    const contactError = root.querySelector<HTMLElement>('[data-contact-error]')!;
    const sentBlock = root.querySelector<HTMLElement>('[data-sent]')!;
    const questionSets = Array.from(root.querySelectorAll<HTMLElement>('fieldset.question'));

    // With JavaScript the contact form only appears after choosing the adviser option
    const setContactVisible = (visible: boolean) => {
      contact.hidden = !visible;
      contactSubmit.hidden = !visible;
    };
    setContactVisible(false);

    const validateQuestions = () => {
      const invalid: string[] = [];
      const required = ['situation', 'children', 'home', 'documents'];
      if (!minorsQuestion.hidden) required.push('minors');
      for (const name of required) if (showError(name, !value(name))) invalid.push(name);
      return invalid;
    };

    const validateContact = () => {
      const invalid: string[] = [];
      if (showError('name', value('name').trim().length < 2)) invalid.push('name');
      if (showError('email', !emailPattern.test(value('email').trim()))) invalid.push('email');
      const phone = value('phone').replace(/[\s-]/g, '');
      if (showError('phone', phone !== '' && !phonePattern.test(phone))) invalid.push('phone');
      const consent = form.querySelector<HTMLInputElement>('[name="consent"]')!.checked;
      if (showError('consent', !consent)) invalid.push('consent');
      return invalid;
    };

    const currentAnswers = () =>
      ({
        situation: value('situation'),
        children: value('children'),
        home: value('home'),
        documents: value('documents'),
        ...(value('minors') ? { minors: value('minors') } : {}),
        ...(value('notary') ? { notary: value('notary') } : {}),
      }) as Answers;

    // Step 1: show the attention points and the two options
    root.querySelector('[data-show-result]')!.addEventListener('click', () => {
      const invalid = validateQuestions();
      formError.hidden = invalid.length === 0;
      if (invalid.length > 0) {
        form.querySelector<HTMLElement>(`[name="${invalid[0]}"]`)?.focus();
        return;
      }
      const answers = currentAnswers();
      track('check_submitted', {
        segment: getSegment(answers, root.dataset.segmentPage || undefined),
        priority: getPriority(getScore(answers, false)),
        landingPage: window.location.pathname,
      });

      flagList.replaceChildren(
        ...getFlags(answers).map((flag) => {
          const content = flagContent[flag];
          const item = document.createElement('li');
          item.className = 'flag';
          const title = document.createElement('h4');
          title.textContent = content.title;
          const text = document.createElement('p');
          text.textContent = content.text;
          const link = document.createElement('a');
          link.href = content.href;
          link.className = 'link-arrow';
          link.textContent = 'Lees meer →';
          item.append(title, text, link);
          return item;
        })
      );
      // A blended family is usually more complex: recommend the adviser
      root.querySelector<HTMLElement>('[data-recommended]')!.hidden = answers.children !== 'blended';

      questionSets.forEach((set) => (set.hidden = true));
      stepActions.hidden = true;
      result.hidden = false;
      result.focus();
    });

    // Option 1: self-service with the assistant (answers go along in this tab only)
    root.querySelector('[data-option-self]')!.addEventListener('click', () => {
      try {
        sessionStorage.setItem('hn_check_answers', JSON.stringify(currentAnswers()));
      } catch {
        // storage unavailable: the assistant simply starts without the check answers
      }
      track('check_option_selfservice');
      window.location.href = '/regel-het-zelf';
    });

    // Option 2: adviser - show the contact form
    root.querySelector('[data-option-adviser]')!.addEventListener('click', () => {
      track('check_option_adviser');
      setContactVisible(true);
      form.querySelector<HTMLInputElement>('[name="name"]')?.focus();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const invalid = [...validateQuestions(), ...validateContact()];
      contactError.hidden = invalid.length === 0;
      if (invalid.length > 0) {
        form.querySelector<HTMLElement>(`[name="${invalid[0]}"]`)?.focus();
        return;
      }

      const answers = currentAnswers();
      // Honeypot filled: behave as if sent, send nothing (docs/10)
      const isBot = value('company_website') !== '';
      const endpoint = root.dataset.endpoint ?? '';
      let sent = false;

      if (endpoint && !isBot) {
        const phone = value('phone').replace(/[\s-]/g, '');
        const payload = {
          answers,
          contact: { name: value('name').trim(), email: value('email').trim(), ...(phone ? { phone } : {}) },
          consent: { given: true, text: root.dataset.consentText, at: new Date().toISOString() },
          source: {
            landingPage: window.location.pathname,
            segmentPage: root.dataset.segmentPage || undefined,
            ref: pageParams.get('ref') ?? undefined,
            utm_source: pageParams.get('utm_source') ?? undefined,
            utm_medium: pageParams.get('utm_medium') ?? undefined,
            utm_campaign: pageParams.get('utm_campaign') ?? undefined,
            referrer: document.referrer || undefined,
            domain: window.location.hostname.endsWith('heldernalaten.nl') ? 'heldernalaten.nl' : 'jouwtestament.nl',
          },
        };
        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          sent = response.ok;
          if (sent) track('contact_requested');
        } catch {
          sent = false;
        }
      }

      root.querySelector<HTMLElement>('[data-thanks]')!.hidden = !(sent || isBot);
      root.querySelector<HTMLElement>('[data-not-connected]')!.hidden = endpoint !== '' || isBot;
      root.querySelector<HTMLElement>('[data-send-failed]')!.hidden = endpoint === '' || sent || isBot;
      if (sent || isBot) form.hidden = true;
      sentBlock.hidden = false;
      sentBlock.focus();
    });

    root.querySelector('[data-check-reset]')?.addEventListener('click', () => {
      questionSets.forEach((set) => (set.hidden = false));
      updateMinors();
      stepActions.hidden = false;
      result.hidden = true;
      setContactVisible(false);
      sentBlock.hidden = true;
      form.querySelector<HTMLInputElement>('input')?.focus();
    });
  });
</script>

<style>
  .check {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    padding: 32px 20px;
    display: grid;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .check {
      padding: 48px;
    }
  }

  @media (min-width: 1024px) {
    .check {
      grid-template-columns: 5fr 7fr;
      gap: 56px;
    }
  }

  .check-intro .lead {
    margin-bottom: 16px;
  }

  fieldset {
    border: 0;
    margin: 0 0 28px;
    padding: 0;
    min-width: 0;
  }

  fieldset[hidden] {
    display: none;
  }

  legend {
    font-weight: 700;
    font-size: var(--fs-body);
    color: var(--color-primary);
    margin-bottom: 12px;
    padding: 0;
  }

  .q-number {
    color: var(--color-muted);
    margin-right: 6px;
  }

  .optional {
    font-weight: 400;
    color: var(--color-muted);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill {
    position: relative;
    cursor: pointer;
  }

  .pill input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .pill span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 18px;
    border: 1.5px solid var(--color-input-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    font-weight: 600;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .pill:hover span {
    border-color: var(--color-primary);
  }

  .pill input:checked + span {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .pill input:focus-visible + span {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .contact {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
  }

  .field {
    margin-bottom: 16px;
  }

  .field label {
    display: block;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .field input {
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    font: inherit;
    border: 1.5px solid var(--color-input-border);
    border-radius: var(--radius-input);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .field input:focus-visible {
    border-color: var(--color-primary);
  }

  .field input[aria-invalid='true'] {
    border-color: var(--color-accent-hover);
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
    cursor: pointer;
  }

  .consent input {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: var(--color-primary);
  }

  .error {
    color: var(--color-accent-hover);
    font-size: var(--fs-small);
    font-weight: 600;
    margin: 8px 0 0;
  }

  .form-error {
    margin-bottom: 16px;
  }

  .submit {
    width: 100%;
  }

  @media (min-width: 768px) {
    .submit {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .sent {
      grid-column: 2;
    }
  }

  .result:focus {
    outline: none;
  }

  .flags {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .flags :global(.flag) {
    background: var(--color-ground);
    border-radius: var(--radius-small);
    padding: 20px 24px;
  }

  .flags :global(h4) {
    margin: 0 0 6px;
    font-size: var(--fs-body);
    color: var(--color-primary);
  }

  .flags :global(p) {
    margin: 0 0 8px;
    color: var(--color-ink-soft);
  }

  .send-failed p {
    color: var(--color-accent-hover);
    font-weight: 600;
  }

  .result h3 {
    font-size: var(--fs-h3);
    margin: 0 0 16px;
  }

  .result h3 + .flags {
    margin-bottom: 32px;
  }

  .options {
    display: grid;
    gap: 16px;
    margin-bottom: 16px;
  }

  @media (min-width: 640px) {
    .options {
      grid-template-columns: 1fr 1fr;
    }
  }

  .option {
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-small);
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .option h4 {
    margin: 0;
    font-size: var(--fs-body);
    color: var(--color-primary);
  }

  .option p {
    margin: 0;
  }

  .option-price {
    font-weight: 700;
    color: var(--color-primary);
    flex-grow: 1;
  }

  .recommended {
    font-size: var(--fs-small);
    background: var(--color-tint);
    color: var(--color-primary);
    border-radius: var(--radius-pill);
    padding: 2px 10px;
  }

  .link-button {
