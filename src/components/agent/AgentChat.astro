---
// Self-service agent UI (option 1, docs/13-agent.md): intro + consent → intake form with the basic
// questions (owner 2026-10-01, saves tokens) → conversation with a live dossier panel →
// (payment, test mode) → the two documents to print or download.
// The conversation is kept in sessionStorage of this tab only; nothing is stored by Helder Nalaten.
import { dossierGroups } from './dossier';
import IntakeChoice from './IntakeChoice.astro';
import { pricing, euro } from '../../config/pricing';

const price = euro(pricing.selfService);
const thisYear = new Date().getFullYear();
const yesNo: [string, string][] = [
  ['no', 'Nee'],
  ['yes', 'Ja'],
];
---

<div class="agent" data-agent>
  <!-- 1. Intro -->
  <section class="panel intro" data-stage="intro" aria-labelledby="agent-intro-title">
    <h2 id="agent-intro-title">Zo werkt het</h2>
    <ol class="how">
      <li>Je vult eerst een kort formulier in met je basisgegevens, zoals je relatie, kinderen en woning.</li>
      <li>Daarna stelt onze digitale assistent de vragen over je wensen, in je eigen tempo. Hij legt de keuzes uit en zet alles op een rij. Je ziet rechts wat er al is vastgelegd.</li>
      <li>Je controleert de samenvatting. Daarna maken we twee documenten voor {price}: een instructie voor de notaris en een uitleg voor je nabestaanden.</li>
      <li>Met de instructie ga je naar een notaris uit ons netwerk of naar je eigen notaris. De notaris controleert alles. Pas na ondertekening is je testament geldig.</li>
    </ol>
    <div class="note">
      <p><strong>Goed om te weten</strong></p>
      <ul>
        <li>De assistent geeft uitleg, geen persoonlijk juridisch of financieel advies.</li>
        <li>Is je situatie ingewikkeld, bijvoorbeeld met een eigen bedrijf of bezit in het buitenland? Dan raadt de assistent een gesprek met een adviseur aan.</li>
        <li>Deel geen BSN, rekeningnummers of wachtwoorden.</li>
      </ul>
    </div>
    <label class="consent">
      <input type="checkbox" data-consent />
      <span>
        Ik begrijp dat mijn antwoorden naar een AI-dienst (Claude van Anthropic) worden gestuurd om het gesprek te
        voeren. Anthropic gebruikt ze niet om modellen te trainen en verwijdert ze binnen 30 dagen. Helder Nalaten
        bewaart het gesprek niet; het blijft alleen in dit browsertabblad staan tot je het tabblad sluit.{' '}
        <a href="/privacy">Privacyverklaring</a>
      </span>
    </label>
    <p class="error" hidden data-consent-error>Vink dit aan om te beginnen.</p>
    <div class="btn-row">
      <button type="button" class="btn-primary" data-start>Begin met het formulier</button>
      <a class="btn-secondary" href="/afspraak" data-choose-adviser>Liever een adviseur</a>
    </div>
    <p class="small unavailable" hidden data-unavailable>
      De assistent is op dit moment niet beschikbaar. Probeer het later opnieuw, of kies voor een gesprek met een adviseur.
    </p>
  </section>

  <!-- 2. Intake form: the basic questions, so the assistant does not have to ask them -->
  <section class="panel intake" data-stage="form" hidden aria-labelledby="intake-title">
    <h2 id="intake-title">Eerst je basisgegevens</h2>
    <p>Deze vragen stelt de assistent anders ook. Met dit formulier ben je sneller klaar. Daarna gaat het gesprek over je wensen.</p>
    <form data-intake-form novalidate>
      <fieldset class="block">
        <legend>Over jou</legend>
        <div class="text-row">
          <div class="text-field" data-text-field>
            <label for="intake-name">Je volledige naam</label>
            <input id="intake-name" name="name" type="text" autocomplete="name" maxlength="100" required aria-describedby="intake-name-error" />
            <p class="q-error" id="intake-name-error" hidden>Vul je naam in.</p>
          </div>
          <div class="text-field short" data-text-field>
            <label for="intake-birthYear">Geboortejaar</label>
            <input id="intake-birthYear" name="birthYear" type="number" inputmode="numeric" min="1900" max={thisYear} required aria-describedby="intake-birthYear-error" />
            <p class="q-error" id="intake-birthYear-error" hidden>Vul een geldig jaar in, bijvoorbeeld 1975.</p>
          </div>
          <div class="text-field" data-text-field>
            <label for="intake-city">Woonplaats <span class="optional">(niet verplicht)</span></label>
            <input id="intake-city" name="city" type="text" autocomplete="address-level2" maxlength="80" />
          </div>
        </div>
        <IntakeChoice name="otherNationality" legend="Heb je (ook) een andere nationaliteit dan de Nederlandse?" options={yesNo} />
        <IntakeChoice name="abroad" legend="Woon je in het buitenland, of heb je bezit in het buitenland?" options={yesNo} />
      </fieldset>

      <fieldset class="block">
        <legend>Relatie</legend>
        <IntakeChoice
          name="relationship"
          legend="Wat is je situatie?"
          options={[
            ['married', 'Getrouwd'],
            ['registered', 'Geregistreerd partnerschap'],
            ['cohabiting', 'Samenwonend, niet getrouwd'],
            ['single', 'Alleenstaand'],
            ['divorced', 'Gescheiden'],
            ['widowed', 'Weduwe of weduwnaar'],
          ]}
        />
        <fieldset class="sub" data-show-if="married" hidden disabled>
          <legend class="sr-only">Over je huwelijk</legend>
          <IntakeChoice
            name="regime"
            legend="Hoe zijn jullie getrouwd?"
            hint="Getrouwd vanaf 1 januari 2018 zonder huwelijksvoorwaarden? Dan is het meestal een beperkte gemeenschap."
            options={[
              ['community', 'Gemeenschap van goederen'],
              ['limited', 'Beperkte gemeenschap van goederen'],
              ['prenup', 'Huwelijksvoorwaarden'],
              ['unknown', 'Weet ik niet'],
            ]}
          />
          <div class="text-field short" data-text-field>
            <label for="intake-since">Sinds welk jaar? <span class="optional">(niet verplicht)</span></label>
            <input id="intake-since" name="since" type="number" inputmode="numeric" min="1900" max={thisYear} aria-describedby="intake-since-error" />
            <p class="q-error" id="intake-since-error" hidden>Vul een geldig jaar in.</p>
          </div>
        </fieldset>
        <fieldset class="sub" data-show-if="cohabiting" hidden disabled>
          <legend class="sr-only">Over samenwonen</legend>
          <IntakeChoice
            name="contract"
            legend="Hebben jullie een samenlevingscontract?"
            options={[
              ['notarial', 'Ja, bij de notaris'],
              ['private', 'Ja, zelf opgesteld'],
              ['none', 'Nee'],
              ['unknown', 'Weet ik niet'],
            ]}
          />
        </fieldset>
        <fieldset class="sub" data-show-if="partner" hidden disabled>
          <legend class="sr-only">Over je partner</legend>
          <div class="text-field" data-text-field>
            <label for="intake-partnerName">Naam van je partner <span class="optional">(niet verplicht)</span></label>
            <input id="intake-partnerName" name="partnerName" type="text" maxlength="100" />
          </div>
          <IntakeChoice name="stepchildren" legend="Heeft je partner kinderen uit een eerdere relatie?" options={yesNo} />
          <IntakeChoice
            name="togetherWithPartner"
            legend="Maakt je partner ook een testament?"
            options={[
              ['yes', 'Ja'],
              ['no', 'Nee'],
              ['unknown', 'Weet ik nog niet'],
            ]}
          />
        </fieldset>
        <IntakeChoice name="earlierRelationship" legend="Ben je eerder getrouwd geweest, of had je een eerdere relatie met kinderen?" options={yesNo} />
      </fieldset>

      <fieldset class="block">
        <legend>Kinderen</legend>
        <IntakeChoice name="hasChildren" legend="Heb je kinderen?" options={yesNo} />
        <fieldset class="sub" data-show-if="children" hidden disabled>
          <legend class="sr-only">Je kinderen</legend>
          <div class="children" data-children></div>
          <button type="button" class="btn-quiet" data-add-child>Nog een kind toevoegen</button>
        </fieldset>
      </fieldset>

      <fieldset class="block">
        <legend>Woning en bezit</legend>
        <IntakeChoice
          name="home"
          legend="Hoe woon je?"
          options={[
            ['owner', 'Koopwoning'],
            ['rent', 'Huurwoning'],
            ['none', 'Geen eigen woning'],
          ]}
        />
        <fieldset class="sub" data-show-if="owner-partner" hidden disabled>
          <legend class="sr-only">Over je woning</legend>
          <IntakeChoice
            name="homeOwner"
            legend="Op wiens naam staat de woning?"
            options={[
              ['me', 'Op mijn naam'],
              ['together', 'Op naam van ons samen'],
              ['partner', 'Op naam van mijn partner'],
            ]}
          />
        </fieldset>
        <IntakeChoice name="business" legend="Heb je een eigen bedrijf of aandelen in een bv?" options={yesNo} />
        <IntakeChoice
          name="documents"
          legend="Wat heb je al geregeld?"
          multiple
          options={[
            ['will', 'Testament'],
            ['lpa', 'Levenstestament'],
            ['codicil', 'Codicil'],
            ['none', 'Nog niets'],
            ['unknown', 'Weet ik niet'],
          ]}
        />
        <fieldset class="sub" data-show-if="will" hidden disabled>
          <legend class="sr-only">Over je testament</legend>
          <div class="text-field short" data-text-field>
            <label for="intake-willYear">Uit welk jaar is je testament? <span class="optional">(niet verplicht)</span></label>
            <input id="intake-willYear" name="willYear" type="number" inputmode="numeric" min="1900" max={thisYear} aria-describedby="intake-willYear-error" />
            <p class="q-error" id="intake-willYear-error" hidden>Vul een geldig jaar in.</p>
          </div>
        </fieldset>
      </fieldset>

      <fieldset class="block">
        <legend>Notaris</legend>
        <IntakeChoice
          name="notary"
          legend="Bij welke notaris wil je je testament laten vastleggen?"
          options={[
            ['network', 'Notaris uit ons netwerk'],
            ['own', 'Mijn eigen notaris'],
            ['unknown', 'Weet ik nog niet'],
          ]}
        />
      </fieldset>

      <p class="form-error" hidden data-intake-error role="alert">Niet alle vragen zijn ingevuld. Kijk de gemarkeerde vragen na.</p>
      <div class="btn-row">
        <button type="submit" class="btn-primary">Verder naar het gesprek</button>
        <button type="button" class="link-button" data-intake-back>Terug</button>
      </div>
    </form>

    <template data-child-template>
      <fieldset class="child" data-child>
        <legend>Kind <span data-child-number></span></legend>
        <div class="text-row">
          <div class="text-field" data-text-field>
            <label>Naam</label>
            <input name="childName" type="text" maxlength="80" required />
            <p class="q-error" hidden>Vul een naam in.</p>
          </div>
          <div class="text-field short" data-text-field>
            <label>Geboortejaar</label>
            <input name="childYear" type="number" inputmode="numeric" min="1900" max={thisYear} required />
            <p class="q-error" hidden>Vul een geldig jaar in.</p>
          </div>
          <div class="text-field" data-text-field>
            <label>Van wie?</label>
            <select name="childRelation" required>
              <option value="">Kies…</option>
              <option value="joint">Samen met mijn partner</option>
              <option value="earlier">Uit een eerdere relatie</option>
              <option value="own">Mijn kind (geen partner)</option>
            </select>
            <p class="q-error" hidden>Maak een keuze.</p>
          </div>
        </div>
        <button type="button" class="link-button" data-remove-child>Verwijder dit kind</button>
      </fieldset>
    </template>
  </section>

  <!-- 3. Conversation -->
  <div class="chat-layout" data-stage="chat" hidden>
    <section class="panel chat" aria-label="Gesprek met de assistent">
      <div class="messages" data-messages aria-live="polite"></div>

      <div class="banner adviser" hidden data-adviser-banner role="status">
        <p><strong>Een adviseur is hier waarschijnlijk beter.</strong> <span data-adviser-reason></span></p>
        <div class="btn-row">
          <a class="btn-primary" href="/afspraak" data-choose-adviser>Plan een gesprek met een adviseur</a>
          <button type="button" class="btn-secondary" data-continue-anyway>Toch verder met de assistent</button>
        </div>
      </div>

      <div class="banner ready" hidden data-ready-banner role="status">
        <p><strong>Je wensen staan op een rij.</strong> We maken nu twee documenten: een instructie voor de notaris en een uitleg voor je nabestaanden.</p>
        <p class="price-line">Prijs: <strong>{price}</strong> <span class="test-badge">Testfase: je betaalt nu niets</span></p>
        <button type="button" class="btn-primary" data-make-documents>Maak mijn documenten</button>
      </div>

      <form class="composer" data-composer>
        <label class="sr-only" for="agent-input">Je bericht</label>
        <textarea id="agent-input" rows="2" maxlength="4000" placeholder="Typ je antwoord…" data-input></textarea>
        <button type="submit" class="btn-primary" data-send>Verstuur</button>
      </form>
      <p class="small hint">Enter = versturen, Shift + Enter = nieuwe regel. <button type="button" class="link-button" data-reset>Gesprek wissen</button></p>
    </section>

    <aside class="panel dossier" aria-labelledby="dossier-title">
      <h2 id="dossier-title">Jouw dossier</h2>
      <p class="small">Wat de assistent heeft vastgelegd. Klopt iets niet? Zeg het in het gesprek.</p>
      <div class="progress" aria-hidden="true"><span data-progress-bar></span></div>
      {dossierGroups.map((group) => (
        <details class="group" open={group.key === 'jij'}>
          <summary>{group.title}</summary>
          <dl>
            {group.fields.map((field) => (
              <div class="field" data-field={field.key} data-required={field.required ? 'true' : undefined}>
                <dt>{field.label}</dt>
                <dd data-value>—</dd>
              </div>
            ))}
          </dl>
        </details>
      ))}
    </aside>
  </div>

  <!-- 4. Documents -->
  <section class="documents-stage" data-stage="documents" hidden aria-labelledby="documents-title">
    <div class="panel doc-actions">
      <h2 id="documents-title">Je documenten</h2>
      <p data-doc-status>We schrijven je documenten. Dit duurt ongeveer een minuut per document.</p>
      <div class="btn-row" hidden data-doc-buttons>
        <button type="button" class="btn-primary" data-print>Afdrukken of opslaan als pdf</button>
        <button type="button" class="btn-secondary" data-download>Download als bestand</button>
        <button type="button" class="btn-secondary" data-back>Terug naar het gesprek</button>
      </div>
      <p class="small">Neem de instructie mee naar de notaris. De notaris controleert je wensen, maakt de akte op en je ondertekent persoonlijk. Pas dan is je testament geldig.</p>
    </div>
    <div data-documents></div>
  </section>
</div>

<script>
  import { dossierFields, missingRequired, type AgentState } from './dossier';
  import {
    INTAKE_MESSAGES,
    INTAKE_TOOL_ID,
    MAX_CHILDREN,
    hasPartner,
    intakeToDossier,
    isMarried,
    prefillFromCheck,
    validateIntake,
    type Intake,
    type Relationship,
  } from './intake';
  import { track } from '../../lib/analytics';

  const STORAGE_KEY = 'hn_agent_v1';
  const CHECK_KEY = 'hn_check_answers';

  type History = { role: 'user' | 'assistant'; content: unknown }[];
  interface Saved {
    history: History;
    state?: AgentState;
    documents?: AgentDocument[];
    dismissedAdviser?: boolean;
    intake?: Intake; // sent with the first chat turn
    intakeDraft?: Record<string, unknown>; // form answers so far (this tab only)
  }
  interface AgentDocument {
    kind: 'notaris' | 'nabestaanden';
    title: string;
    intro: string;
    sections: { heading: string; paragraphs: string[]; bullets: string[] }[];
    open_points: string[];
  }

  const root = document.querySelector<HTMLElement>('[data-agent]')!;
  const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
  const stages = {
    intro: $('[data-stage="intro"]'),
    form: $('[data-stage="form"]'),
    chat: $('[data-stage="chat"]'),
    documents: $('[data-stage="documents"]'),
  };
  const messagesEl = $('[data-messages]');
  const input = $<HTMLTextAreaElement>('[data-input]');
  const sendButton = $<HTMLButtonElement>('[data-send]');

  // ---------- storage (this tab only) ----------
  const load = (): Saved | null => {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Saved) : null;
    } catch {
      return null;
    }
  };
  const save = (data: Saved) => {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {
      // storage unavailable: the conversation still works until the tab is closed
    }
  };
  let saved: Saved = load() ?? { history: [] };

  const show = (stage: keyof typeof stages) => {
    for (const [key, el] of Object.entries(stages)) el.hidden = key !== stage;
  };

  // ---------- safe, minimal formatting (escape first, then **bold** and lists) ----------
  const escape = (text: string) =>
    text.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const LIST_ITEM = /^\s*([-*•]|\d+[.)])\s+/;
  const inline = (line: string) => escape(line).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

  // Quick replies: the agent ends a closed question with "[OPTIES] a | b | c" (or [MEERKEUZE]).
  const OPTION_LINE = /^\s*\[(OPTIES|MEERKEUZE)\]\s*(.*)$/i;
  /** Also true for a marker that is still arriving while streaming ("[OPT"). */
  const isOptionLine = (line: string) => {
    const t = line.trim().toUpperCase();
    if (!t.startsWith('[')) return false;
    return ['[OPTIES]', '[MEERKEUZE]'].some((m) => t.startsWith(m) || m.startsWith(t));
  };
  function parseOptions(text: string): { multiple: boolean; options: string[] } | null {
    const lines = text.trim().split('\n');
    for (let i = lines.length - 1; i >= 0; i--) {
      const match = OPTION_LINE.exec(lines[i]);
      if (!match) continue;
      const options = match[2].split('|').map((o) => o.trim()).filter(Boolean).slice(0, 8);
      return options.length >= 2 ? { multiple: match[1].toUpperCase() === 'MEERKEUZE', options } : null;
    }
    return null;
  }

  /** Paragraphs, headings (#) and lists, also when a list directly follows a sentence. */
  function format(text: string): string {
    text = text
      .split('\n')
      .filter((line) => !isOptionLine(line))
      .join('\n');
    let html = '';
    for (const block of text.trim().split(/\n{2,}/)) {
      let paragraph: string[] = [];
      let list: string[] = [];
      let ordered = false;
      const flushParagraph = () => {
        if (paragraph.length) html += `<p>${paragraph.map(inline).join('<br>')}</p>`;
        paragraph = [];
      };
      const flushList = () => {
        if (list.length) {
          const items = list.map((item) => `<li>${inline(item)}</li>`).join('');
          html += ordered ? `<ol>${items}</ol>` : `<ul>${items}</ul>`;
        }
        list = [];
      };
      for (const line of block.split('\n')) {
        const heading = /^#{1,4}\s+(.*)$/.exec(line);
        if (heading) {
          flushParagraph();
          flushList();
          html += `<p><strong>${inline(heading[1])}</strong></p>`;
        } else if (LIST_ITEM.test(line)) {
          flushParagraph();
          if (!list.length) ordered = /^\s*\d/.test(line);
          list.push(line.replace(LIST_ITEM, ''));
        } else if (line.trim()) {
          flushList();
          paragraph.push(line);
        }
      }
      flushParagraph();
      flushList();
    }
    return html;
  }

  // ---------- rendering ----------
  function bubble(role: 'user' | 'assistant', text: string): HTMLElement {
    const el = document.createElement('div');
    el.className = `msg ${role}`;
    el.innerHTML = format(text);
    messagesEl.append(el);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return el;
  }

  function visibleText(content: unknown): string {
    if (typeof content === 'string') return content;
    if (!Array.isArray(content)) return '';
    return content
      .filter((block: { type?: string }) => block?.type === 'text')
      .map((block: { text: string }) => block.text)
      .join('\n\n');
  }

  function renderHistory() {
    messagesEl.replaceChildren();
    let lastAssistantText = '';
    // The intake form enters the history as synthetic messages; they are not shown
    const second = saved.history[1]?.content;
    const skip = Array.isArray(second) && second[0]?.id === INTAKE_TOOL_ID ? INTAKE_MESSAGES : 0;
    saved.history.forEach((message, index) => {
      const text = visibleText(message.content).trim();
      if (index < skip || !text || (index === 0 && text.startsWith('[Start'))) return;
      if (message.role === 'user' && Array.isArray(message.content)) return; // tool results
      bubble(message.role, text);
      lastAssistantText = message.role === 'assistant' ? text : '';
    });
    if (lastAssistantText) renderOptions(lastAssistantText);
  }

  function clearOptions() {
    messagesEl.querySelectorAll('.quick-replies').forEach((el) => el.remove());
  }

  /** Clickable answers under the latest assistant message. Typing stays possible. */
  function renderOptions(text: string) {
    clearOptions();
    const parsed = parseOptions(text);
    if (!parsed) return;
    const box = document.createElement('div');
    box.className = 'quick-replies';
    box.setAttribute('role', 'group');
    box.setAttribute('aria-label', parsed.multiple ? 'Kies een of meer antwoorden' : 'Kies een antwoord');
    const chosen = new Set<string>();
    const submit = document.createElement('button');
    submit.type = 'button';
    submit.className = 'btn-primary qr-submit';
    submit.textContent = 'Verstuur keuze';
    submit.disabled = true;
    submit.addEventListener('click', () => send([...chosen].join(', ')));

    for (const option of parsed.options) {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'qr-chip';
      chip.textContent = option;
      const isOther = /^anders/i.test(option);
      if (parsed.multiple && !isOther) chip.setAttribute('aria-pressed', 'false');
      chip.addEventListener('click', () => {
        if (isOther) {
          // "Anders, namelijk…": let the visitor type
          input.value = option.replace(/[.…]+$/, '').replace(/namelijk$/i, 'namelijk ').trimEnd() + ' ';
          input.focus();
          return;
        }
        if (!parsed.multiple) return send(option);
        const on = !chosen.has(option);
        if (on) chosen.add(option);
        else chosen.delete(option);
        chip.setAttribute('aria-pressed', String(on));
        submit.disabled = chosen.size === 0;
      });
      box.append(chip);
    }
    if (parsed.multiple) box.append(submit);
    messagesEl.append(box);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function send(message: string) {
    if (!message || sendButton.disabled) return;
    clearOptions();
    input.value = '';
    turn(message);
  }

  function renderState(state?: AgentState) {
    const dossier = state?.dossier ?? {};
    for (const field of dossierFields) {
      const row = root.querySelector<HTMLElement>(`[data-field="${field.key}"]`);
      if (!row) continue;
      const value = dossier[field.key];
      row.querySelector('[data-value]')!.textContent = value ?? '—';
      row.classList.toggle('filled', Boolean(value));
      if (value) row.closest('details')?.setAttribute('open', '');
    }
    const required = dossierFields.filter((field) => field.required).length;
    const done = required - missingRequired(dossier).length;
    $('[data-progress-bar]').style.width = `${Math.round((done / required) * 100)}%`;

    const adviser = state?.status === 'adviser_recommended' && !saved.dismissedAdviser;
    $('[data-adviser-banner]').hidden = !adviser;
    $('[data-adviser-reason]').textContent = state?.adviserReason ?? '';
    $('[data-ready-banner]').hidden = state?.status !== 'ready';
  }

  function setBusy(busy: boolean) {
    sendButton.disabled = busy;
    input.disabled = busy;
    root.classList.toggle('busy', busy);
  }

  // ---------- NDJSON streaming ----------
  async function stream(url: string, body: unknown, onEvent: (event: any) => void): Promise<boolean> {
    let response: Response;
    try {
      response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    } catch {
      onEvent({ type: 'error', message: 'Geen verbinding. Controleer je internet en probeer het opnieuw.' });
      return false;
    }
    if (!response.ok || !response.body) {
      if (response.status === 503 || response.status === 404) onEvent({ type: 'unavailable' });
      else onEvent({ type: 'error', message: 'Er ging iets mis. Probeer het opnieuw.' });
      return false;
    }
    const reader = response.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';
    for (;;) {
      const { value, done } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      let newline;
      while ((newline = buffer.indexOf('\n')) >= 0) {
        const line = buffer.slice(0, newline).trim();
        buffer = buffer.slice(newline + 1);
        if (line) onEvent(JSON.parse(line));
      }
    }
    return true;
  }

  function checkAnswers(): Record<string, string> | undefined {
    try {
      const raw = sessionStorage.getItem(CHECK_KEY);
      return raw ? JSON.parse(raw) : undefined;
    } catch {
      return undefined;
    }
  }

  async function turn(message: string) {
    setBusy(true);
    if (message) bubble('user', message);
    const reply = bubble('assistant', '');
    reply.classList.add('typing');
    let text = '';
    let failed = false;

    const first = saved.history.length === 0;
    const body = { history: saved.history, message, checkAnswers: checkAnswers(), ...(first && saved.intake ? { intake: saved.intake } : {}) };
    await stream('/api/agent/chat', body, (event) => {
      if (event.type === 'text') {
        text += event.text;
        reply.classList.remove('typing');
        reply.innerHTML = format(text);
        messagesEl.scrollTop = messagesEl.scrollHeight;
      } else if (event.type === 'state') {
        const wasReady = saved.state?.status === 'ready';
        const wasAdviser = saved.state?.status === 'adviser_recommended';
        saved.state = event.state;
        if (event.state.status === 'ready' && !wasReady) track('agent_ready');
        if (event.state.status === 'adviser_recommended' && !wasAdviser) track('agent_adviser_recommended');
        renderState(saved.state);
      } else if (event.type === 'history') {
        saved.history = event.history;
        save(saved);
      } else if (event.type === 'unavailable') {
        failed = true;
        reply.remove();
        show('intro');
        $('[data-unavailable]').hidden = false;
      } else if (event.type === 'error') {
        failed = true;
        reply.classList.remove('typing');
        reply.classList.add('error-msg');
        reply.textContent = event.message;
      }
    });

    if (failed && message) input.value = message; // let the user try again
    if (!text.trim() && !failed) reply.remove();
    setBusy(false);
    if (!failed) {
      renderOptions(text);
      input.focus();
    }
  }

  // ---------- documents ----------
  function renderDocument(doc: AgentDocument): HTMLElement {
    const article = document.createElement('article');
    article.className = 'document';
    const h = (tag: string, text: string) => {
      const el = document.createElement(tag);
      el.textContent = text;
      return el;
    };
    article.append(h('p', doc.kind === 'notaris' ? 'Document 1 · Instructie voor de notaris' : 'Document 2 · Uitleg voor nabestaanden'));
    article.firstElementChild!.className = 'doc-label';
    article.append(h('h2', doc.title), h('p', doc.intro));
    for (const section of doc.sections) {
      article.append(h('h3', section.heading));
      section.paragraphs.forEach((p) => article.append(h('p', p)));
      if (section.bullets.length) {
        const ul = document.createElement('ul');
        section.bullets.forEach((b) => ul.append(h('li', b)));
        article.append(ul);
      }
    }
    if (doc.open_points.length) {
      article.append(h('h3', doc.kind === 'notaris' ? 'Open vragen voor de notaris' : 'Nog aan te vullen'));
      const ul = document.createElement('ul');
      doc.open_points.forEach((b) => ul.append(h('li', b)));
      article.append(ul);
    }
    article.append(
      h('p', `Opgesteld met de assistent van Helder Nalaten op ${new Date().toLocaleDateString('nl-NL')}. Geen testament: alleen de akte van de notaris is bindend.`)
    );
    article.lastElementChild!.className = 'doc-footer';
    return article;
  }

  function showDocuments(documents: AgentDocument[]) {
    const container = $('[data-documents]');
    container.replaceChildren(...documents.map(renderDocument));
    $('[data-doc-buttons]').hidden = false;
    $('[data-doc-status]').textContent = 'Je documenten zijn klaar om te bewaren. Controleer ze goed.';
  }

  async function makeDocuments() {
    show('documents');
    window.scrollTo({ top: 0 });
    $('[data-doc-buttons]').hidden = true;
    const documents: AgentDocument[] = [];
    for (const kind of ['notaris', 'nabestaanden'] as const) {
      $('[data-doc-status]').textContent =
        kind === 'notaris'
          ? 'We schrijven document 1: de instructie voor de notaris. Dit duurt ongeveer een minuut.'
          : 'We schrijven document 2: de uitleg voor je nabestaanden. Nog ongeveer een minuut.';
      let result: AgentDocument | null = null;
      let error = '';
      await stream('/api/agent/documents', { history: saved.history, kind }, (event) => {
        if (event.type === 'document') result = event.document;
        if (event.type === 'error') error = event.message;
        if (event.type === 'unavailable') error = 'De assistent is op dit moment niet beschikbaar.';
      });
      if (!result) {
        $('[data-doc-status]').textContent = error || 'Het maken van de documenten is niet gelukt. Probeer het opnieuw.';
        $('[data-doc-buttons]').hidden = false;
        return;
      }
      documents.push(result);
      showDocuments(documents);
    }
    saved.documents = documents;
    save(saved);
    track('agent_documents_created');
  }

  function download() {
    const docs = $('[data-documents]').innerHTML;
    const html = `<!doctype html><html lang="nl"><head><meta charset="utf-8"><title>Mijn documenten – Helder Nalaten</title>
<style>body{font-family:system-ui,sans-serif;max-width:760px;margin:40px auto;padding:0 20px;line-height:1.6;color:#1b2b27}
h2{margin-top:48px}.doc-label,.doc-footer{color:#5b6763;font-size:14px}.document{page-break-after:always}</style></head><body>${docs}</body></html>`;
    const url = URL.createObjectURL(new Blob([html], { type: 'text/html' }));
    const link = Object.assign(document.createElement('a'), { href: url, download: 'helder-nalaten-documenten.html' });
    link.click();
    URL.revokeObjectURL(url);
  }


  // ---------- intake form ----------
  const form = $<HTMLFormElement>('[data-intake-form]');
  const childrenEl = $('[data-children]');
  const childTemplate = $<HTMLTemplateElement>('[data-child-template]');
  const addChildButton = $<HTMLButtonElement>('[data-add-child]');

  const checked = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value;
  const checkedAll = (name: string) =>
    [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((el) => el.value);
  const field = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:not([type=radio]):not([type=checkbox])`);

  function renumberChildren() {
    const rows = [...childrenEl.querySelectorAll<HTMLElement>('[data-child]')];
    rows.forEach((row, i) => {
      row.querySelector('[data-child-number]')!.textContent = String(i + 1);
      row.querySelectorAll<HTMLElement>('input, select').forEach((el) => {
        const label = el.closest('[data-text-field]')!.querySelector('label')!;
        el.id = `intake-child-${i}-${el.getAttribute('name')}`;
        label.htmlFor = el.id;
        const error = el.closest('[data-text-field]')!.querySelector<HTMLElement>('.q-error')!;
        error.id = `${el.id}-error`;
        el.setAttribute('aria-describedby', error.id);
      });
      row.querySelector<HTMLElement>('[data-remove-child]')!.hidden = rows.length === 1;
    });
    addChildButton.hidden = rows.length >= MAX_CHILDREN;
  }

  function addChild(values?: { name?: string; birthYear?: number | string; relation?: string }, focus = false) {
    const row = (childTemplate.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLElement;
    childrenEl.append(row);
    if (values) {
      row.querySelector<HTMLInputElement>('[name="childName"]')!.value = values.name ?? '';
      row.querySelector<HTMLInputElement>('[name="childYear"]')!.value = values.birthYear ? String(values.birthYear) : '';
      row.querySelector<HTMLSelectElement>('[name="childRelation"]')!.value = values.relation ?? '';
    }
    row.querySelector('[data-remove-child]')!.addEventListener('click', () => {
      row.remove();
      renumberChildren();
      saveDraft();
      childrenEl.querySelector<HTMLInputElement>('[name="childName"]')?.focus();
    });
    renumberChildren();
    if (focus) row.querySelector<HTMLInputElement>('[name="childName"]')!.focus();
  }

  /** Shows the follow-up questions that apply; hidden ones are disabled so they do not count. */
  function updateConditions() {
    const relationship = checked('relationship') as Relationship | undefined;
    const partner = relationship ? hasPartner(relationship) : false;
    const conditions: Record<string, boolean> = {
      married: relationship ? isMarried(relationship) : false,
      cohabiting: relationship === 'cohabiting',
      partner,
      children: checked('hasChildren') === 'yes',
      'owner-partner': checked('home') === 'owner' && partner,
      will: checkedAll('documents').includes('will'),
    };
    form.querySelectorAll<HTMLFieldSetElement>('[data-show-if]').forEach((el) => {
      const on = conditions[el.dataset.showIf!] ?? false;
      el.hidden = !on;
      el.disabled = !on;
    });
    if (conditions.children && !childrenEl.children.length) addChild();
  }

  function collect(): Record<string, unknown> {
    const enabled = (name: string) => {
      const el = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      return el && !el.closest('fieldset:disabled') ? el : null;
    };
    const value = (name: string) => (enabled(name) ? checked(name) : undefined);
    const text = (name: string) => (enabled(name) ? field(name)?.value : undefined);
    return {
      name: text('name'),
      birthYear: text('birthYear'),
      city: text('city'),
      otherNationality: value('otherNationality'),
      abroad: value('abroad'),
      relationship: value('relationship'),
      partnerName: text('partnerName'),
      since: text('since'),
      regime: value('regime'),
      contract: value('contract'),
      stepchildren: value('stepchildren'),
      togetherWithPartner: value('togetherWithPartner'),
      earlierRelationship: value('earlierRelationship'),
      hasChildren: value('hasChildren'),
      children:
        checked('hasChildren') === 'yes'
          ? [...childrenEl.querySelectorAll<HTMLElement>('[data-child]')].map((row) => ({
              name: row.querySelector<HTMLInputElement>('[name="childName"]')!.value,
              birthYear: row.querySelector<HTMLInputElement>('[name="childYear"]')!.value,
              relation: row.querySelector<HTMLSelectElement>('[name="childRelation"]')!.value,
            }))
          : [],
      home: value('home'),
      homeOwner: value('homeOwner'),
      business: value('business'),
      documents: checkedAll('documents'),
      willYear: text('willYear'),
      notary: value('notary'),
    };
  }

  function saveDraft() {
    saved.intakeDraft = collect();
    save(saved);
  }

  function fill(values: Record<string, unknown>) {
    for (const [name, value] of Object.entries(values)) {
      if (value === undefined || value === null || name === 'children') continue;
      const values = Array.isArray(value) ? value.map(String) : [String(value)];
      form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach((el) => {
        if (el.type === 'radio' || el.type === 'checkbox') el.checked = values.includes(el.value);
        else el.value = values[0];
      });
    }
    updateConditions();
    const children = values.children;
    if (Array.isArray(children) && children.length) {
      childrenEl.replaceChildren();
      children.forEach((child) => addChild(child));
    }
  }

  /** Marks unanswered visible questions; returns the first one to focus, or null when all is fine. */
  function markErrors(): HTMLElement | null {
    let first: HTMLElement | null = null;
    const flag = (container: HTMLElement, invalid: boolean, focusTarget: HTMLElement) => {
      container.classList.toggle('invalid', invalid);
      const error = container.querySelector<HTMLElement>(':scope > .q-error, :scope .q-error');
      if (error) error.hidden = !invalid;
      focusTarget.setAttribute('aria-invalid', String(invalid));
      if (invalid && !first) first = focusTarget;
    };
    form.querySelectorAll<HTMLFieldSetElement>('fieldset.q[data-required]').forEach((q) => {
      if (q.closest('fieldset:disabled')) return;
      const inputs = [...q.querySelectorAll<HTMLInputElement>('input')];
      flag(q, !inputs.some((el) => el.checked), inputs[0]);
    });
    form.querySelectorAll<HTMLElement>('[data-text-field]').forEach((wrapper) => {
      const el = wrapper.querySelector<HTMLInputElement | HTMLSelectElement>('input, select')!;
      if (el.closest('fieldset:disabled')) return;
      const value = el.value.trim();
      flag(wrapper, (el.required && !value) || !el.checkValidity(), el);
    });
    return first;
  }

  form.addEventListener('change', (event) => {
    const target = event.target as HTMLInputElement;
    // "Nog niets" and "Weet ik niet" exclude the other document choices
    if (target.name === 'documents' && target.checked) {
      const exclusive = ['none', 'unknown'];
      form.querySelectorAll<HTMLInputElement>('input[name="documents"]').forEach((el) => {
        if (el !== target && (exclusive.includes(target.value) || exclusive.includes(el.value))) el.checked = false;
      });
    }
    updateConditions();
    saveDraft();
    if (form.querySelector('.invalid')) markErrors();
  });
  form.addEventListener('input', () => saveDraft());

  addChildButton.addEventListener('click', () => {
    addChild(undefined, true);
    saveDraft();
  });

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const first = markErrors();
    const intake = first ? null : validateIntake(collect());
    $('[data-intake-error]').hidden = Boolean(intake);
    if (!intake) {
      (first ?? form.querySelector<HTMLElement>('input'))?.focus();
      return;
    }
    saved.intake = intake;
    save(saved);
    track('agent_intake_completed');
    show('chat');
    renderState({ dossier: intakeToDossier(intake), status: 'intake' });
    window.scrollTo({ top: 0 });
    turn('');
  });

  $('[data-intake-back]').addEventListener('click', () => {
    show('intro');
    $<HTMLButtonElement>('[data-start]').focus();
  });

  function openForm() {
    show('form');
    if (!form.dataset.filled) {
      form.dataset.filled = 'true';
      fill({ ...prefillFromCheck(checkAnswers()), ...(saved.intakeDraft ?? {}) });
    }
    window.scrollTo({ top: 0 });
    $<HTMLInputElement>('#intake-name').focus();
  }

  // ---------- events ----------
  $('[data-start]').addEventListener('click', () => {
    const consent = $<HTMLInputElement>('[data-consent]');
    $('[data-consent-error]').hidden = consent.checked;
    if (!consent.checked) return;
    track('agent_started');
    openForm();
  });

  $('[data-composer]').addEventListener('submit', (event) => {
    event.preventDefault();
    // The first turn failed (no history yet): start again instead of losing the message
    if (saved.history.length === 0) {
      messagesEl.replaceChildren();
      turn('');
      return;
    }
    send(input.value.trim());
  });

  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      $<HTMLFormElement>('[data-composer]').requestSubmit();
    }
  });

  $('[data-continue-anyway]').addEventListener('click', () => {
    saved.dismissedAdviser = true;
    save(saved);
    renderState(saved.state);
    input.focus();
  });

  root.querySelectorAll('[data-choose-adviser]').forEach((link) =>
    link.addEventListener('click', () => track('agent_option_adviser'))
  );

  $('[data-make-documents]').addEventListener('click', makeDocuments);
  $('[data-print]').addEventListener('click', () => window.print());
  $('[data-download]').addEventListener('click', download);
  $('[data-back]').addEventListener('click', () => show('chat'));

  $('[data-reset]').addEventListener('click', () => {
    if (!confirm('Weet je zeker dat je het gesprek wilt wissen? Dit kan niet ongedaan worden gemaakt.')) return;
    saved = { history: [] };
    form.reset();
    childrenEl.replaceChildren();
    delete form.dataset.filled;
    updateConditions();
    try {
      sessionStorage.removeItem(STORAGE_KEY);
    } catch {
      // ignore
    }
    messagesEl.replaceChildren();
    renderState(undefined);
    show('intro');
  });

  // ---------- resume ----------
  if (saved.history.length > 0) {
    show('chat');
    renderHistory();
    renderState(saved.state);
    if (saved.documents?.length) {
      showDocuments(saved.documents);
    }
  } else {
    show('intro');
  }
</script>

