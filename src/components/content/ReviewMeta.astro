---
// Reviewer + last updated (docs/11, E-E-A-T). Placeholders until the owner fills them in.
import { site } from '../../config/site';
interface Props {
  updated?: string; // e.g. "27 september 2026"; leave empty until content is reviewed
  readingTime?: string;
}
const { updated, readingTime } = Astro.props;
---

<p class="review-meta">
  Gecontroleerd door <a href={`/over-ons#${site.reviewer.anchor}`}>{site.reviewer.name}</a>
  · Laatst bijgewerkt: {updated ?? <span class="placeholder">[DATUM]</span>}
  {readingTime && <> · Leestijd: {readingTime}</>}
</p>

<style>
  .review-meta {
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  a {
    color: var(--color-muted);
  }
</style>
