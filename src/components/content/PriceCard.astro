---
// Price card (docs/04): white, or highlighted (dark) for the partner package.
import { Check } from '@lucide/astro';
interface Props {
  title: string;
  price: string;
  note?: string;
  included?: string[];
  highlight?: boolean;
}
const { title, price, note, included = [], highlight = false } = Astro.props;
---

<article class:list={['price-card', { highlight }]}>
  <h3>{title}</h3>
  <p class="price">{price}</p>
  {note && <p class="note">{note}</p>}
  {included.length > 0 && (
    <ul>
      {included.map((item) => (
        <li><Check size={18} stroke-width={1.8} aria-hidden="true" />{item}</li>
      ))}
    </ul>
  )}
</article>

<style>
  .price-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 28px;
    height: 100%;
  }

  .price-card.highlight {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary-soft);
  }

  h3 {
    margin-bottom: 12px;
  }

  .highlight h3,
  .highlight .price {
    color: #fff;
  }

  .price {
    font-family: var(--font-display);
    font-size: 42px;
    line-height: 1.1;
    color: var(--color-primary);
    margin: 0 0 8px;
  }

  .note {
    font-size: 16px;
    color: var(--color-muted);
  }

  .highlight .note {
    color: var(--color-on-primary-soft);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }

  li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  li + li {
    margin-top: 8px;
  }

  li :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--color-accent);
  }

  .highlight li :global(svg) {
    color: var(--color-on-primary-soft);
  }
</style>
