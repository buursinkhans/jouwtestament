---
// "Kort antwoord" block (docs/04, docs/11): self-contained answer an AI can quote.
interface Props {
  id?: string;
}
const { id = 'kort-antwoord' } = Astro.props;
---

<section class="short-answer" aria-labelledby={id}>
  <p class="label" id={id}>Kort antwoord</p>
  <div class="text"><slot /></div>
</section>

<style>
  .short-answer {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    padding: 24px 28px;
    margin: 24px 0 40px;
  }

  .label {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-muted);
    margin: 0 0 8px;
  }

  .text {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .text :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
