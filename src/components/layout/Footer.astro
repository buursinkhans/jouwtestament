---
// Footer with four columns (docs/03).
import { site, canShow, devOnly } from '../../config/site';
import { voorWieItems, footerMore, footerLegal } from '../../config/navigation';

// Terms are not written yet: only link them in development.
const legalLinks = footerLegal.filter((item) => devOnly || item.href !== '/voorwaarden');

const shortDescription =
  'Financieel advies over je nalatenschap, met een instructie voor de notaris en een uitleg voor je nabestaanden.';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-name">{site.name}</p>
      <p>{site.tagline}</p>
      <p>{shortDescription}</p>
      <p>
        {canShow(site.contact.phone) && <><span class="placeholder">{site.contact.phone}</span><br /></>}
        {canShow(site.contact.email) && <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>}
      </p>
    </div>
    <div>
      <h2>Voor wie</h2>
      <ul>
        {voorWieItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Meer</h2>
      <ul>
        {footerMore.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Juridisch</h2>
      <ul>
        {legalLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        {canShow(site.kvk) && <li>KvK <span class="placeholder">{site.kvk}</span></li>}
        {canShow(site.reviewer.name) && (
          <li>
            Inhoud gecontroleerd door <a href={`/over-ons#${site.reviewer.anchor}`}>{site.reviewer.name}</a>
          </li>
        )}
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} {site.name}. De informatie op deze site is algemeen en geen persoonlijk juridisch of financieel advies.</p>
  </div>
</footer>

<style>
  /* Light footer: no large coloured areas (docs/04, 2026-09-28) */
  .site-footer {
    background: var(--color-ground);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    padding: 56px 0 calc(96px + env(safe-area-inset-bottom));
    font-size: var(--fs-small);
  }

  .footer-grid {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
    .site-footer {
      padding-bottom: 40px;
    }
  }

  .footer-name {
    font-weight: 700;
    font-size: var(--fs-h3);
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  h2 {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 14px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    margin-top: 10px;
  }

  a {
    color: var(--color-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    margin-top: 40px;
    padding-top: 20px;
  }
</style>
