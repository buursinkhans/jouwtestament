---
// Header with "Voor wie" dropdown (desktop) and full-screen menu (mobile). docs/03, docs/04.
import { ChevronDown } from '@lucide/astro';
import { site } from '../../config/site';
import { mainNav, voorWieItems, cta } from '../../config/navigation';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="logo" href="/">
      <span class="logo-name">{site.name}</span>
      <span class="logo-tagline">{site.tagline}</span>
    </a>

    <nav class="desktop-nav" aria-label="Hoofdmenu">
      <div class="nav-dropdown" data-dropdown>
        <button
          type="button"
          class="nav-link dropdown-button"
          aria-expanded="false"
          aria-controls="voor-wie-panel"
          data-dropdown-button
        >
          Voor wie <ChevronDown size={18} stroke-width={1.8} aria-hidden="true" />
        </button>
        <div id="voor-wie-panel" class="dropdown-panel" hidden data-dropdown-panel>
          <ul>
            {voorWieItems.map((item) => (
              <li>
                <a class="dropdown-item" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="item-label">{item.label}</span>
                  <span class="item-sub">{item.sub}</span>
                </a>
              </li>
            ))}
            <li>
              <a class="dropdown-item dropdown-all" href="/voor-wie">
                <span class="item-label">Alle situaties →</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      {mainNav.map((item) => (
        <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a class="btn-primary header-cta" href={cta.href}>{cta.label}</a>
    </nav>

    <button
      type="button"
      class="menu-button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <span class="menu-icon" aria-hidden="true"></span>
      <span class="menu-label">Menu</span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden data-mobile-menu>
    <nav class="container" aria-label="Mobiel menu">
      <details class="mobile-group" open={path.startsWith('/voor-wie')}>
        <summary>Voor wie</summary>
        <ul>
          {voorWieItems.map((item) => (
            <li>
              <a href={item.href}>
                <span class="item-label">{item.label}</span>
                <span class="item-sub">{item.sub}</span>
              </a>
            </li>
          ))}
          <li><a href="/voor-wie"><span class="item-label">Alle situaties →</span></a></li>
        </ul>
      </details>
      <ul class="mobile-links">
        {mainNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn-primary mobile-cta" href={cta.href}>{cta.label}</a>
    </nav>
  </div>
</header>

<script>
  import { track } from '../../lib/analytics';

  const header = document.querySelector<HTMLElement>('[data-header]');
  window.addEventListener(
    'scroll',
    () => header?.classList.toggle('is-scrolled', window.scrollY > 4),
    { passive: true }
  );

  // "Voor wie" dropdown: opens on click, closes with Esc and click outside, arrow keys navigate.
  const dropdown = document.querySelector<HTMLElement>('[data-dropdown]');
  const button = dropdown?.querySelector<HTMLButtonElement>('[data-dropdown-button]');
  const panel = dropdown?.querySelector<HTMLElement>('[data-dropdown-panel]');
  const items = () => Array.from(panel?.querySelectorAll<HTMLAnchorElement>('a') ?? []);

  const setOpen = (open: boolean, focusFirst = false) => {
    if (!button || !panel) return;
    button.setAttribute('aria-expanded', String(open));
    if (open && panel.hidden) track('nav_voor_wie_opened');
    panel.hidden = !open;
    if (open && focusFirst) items()[0]?.focus();
  };

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  button?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setOpen(true, true);
    }
  });
  panel?.addEventListener('keydown', (event) => {
    const list = items();
    const index = list.indexOf(document.activeElement as HTMLAnchorElement);
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const step = event.key === 'ArrowDown' ? 1 : -1;
      list[(index + step + list.length) % list.length]?.focus();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (dropdown && !dropdown.contains(event.target as Node)) setOpen(false);
  });
  dropdown?.addEventListener('focusout', (event) => {
    if (!dropdown.contains(event.relatedTarget as Node)) setOpen(false);
  });

  // Mobile full-screen menu
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const setMenu = (open: boolean) => {
    if (!menuButton || !mobileMenu) return;
    menuButton.setAttribute('aria-expanded', String(open));
    mobileMenu.hidden = !open;
    document.body.classList.toggle('menu-open', open);
    menuButton.querySelector('.menu-label')!.textContent = open ? 'Sluiten' : 'Menu';
  };
  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    transition: box-shadow 0.2s ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 4px 16px rgba(31, 61, 54, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
  }

  .logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-primary);
  }

  .logo-name {
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.1;
  }

  .logo-tagline {
    display: none;
  }

  .desktop-nav {
    display: none;
  }

  .nav-link {
    background: none;
    border: 0;
    padding: 8px 4px;
    font: inherit;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .dropdown-button[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .nav-dropdown {
    position: relative;
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: -16px;
    width: 640px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    box-shadow: var(--shadow-card);
    padding: 12px;
  }

  .dropdown-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    border-radius: var(--radius-input);
    text-decoration: none;
  }

  .dropdown-item:hover,
  .dropdown-item:focus-visible,
  .dropdown-item[aria-current='page'] {
    background: var(--color-ground);
  }

  .item-label {
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--color-primary);
  }

  .item-sub {
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 14px;
    background: none;
    border: 1.5px solid var(--color-primary);
    border-radius: var(--radius-pill);
    color: var(--color-primary);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    position: relative;
  }

  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
  }

  .menu-icon::before {
    top: -6px;
  }

  .menu-icon::after {
    top: 6px;
  }

  .mobile-menu {
    position: fixed;
    inset: 64px 0 0;
    background: var(--color-ground);
    overflow-y: auto;
    padding: 24px 0 40px;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-group summary {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--color-primary);
    padding: 12px 0;
    cursor: pointer;
  }

  .mobile-group ul,
  .mobile-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-group a {
    display: flex;
    flex-direction: column;
    padding: 10px 0 10px 16px;
    text-decoration: none;
  }

  .mobile-links {
    border-top: 1px solid var(--color-border);
    margin-top: 12px;
  }

  .mobile-links a {
    display: block;
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-cta {
    width: 100%;
    margin-top: 28px;
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .header-inner {
      min-height: 76px;
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .header-cta {
      margin-left: 8px;
    }

    .menu-button,
    .mobile-menu {
      display: none !important;
    }
  }
</style>
