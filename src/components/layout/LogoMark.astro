---
// Logo mark, option A "Heldere lijn" (owner 2026-09-30): an H whose crossbar runs on as a line,
// passing something on. Keep in sync with design/logo/generate-assets.mjs.
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---

<svg class="logo-mark" viewBox="0 0 120 120" width={size} height={size} aria-hidden="true" focusable="false">
  <rect width="120" height="120" rx="28" fill="var(--color-primary)"></rect>
  <path d="M32 30v60M32 60h26M58 30v60" stroke="#fff" stroke-width="11" stroke-linecap="round"></path>
  <path d="M58 60h32" stroke="var(--color-accent)" stroke-width="11" stroke-linecap="round"></path>
</svg>

<style>
  .logo-mark {
    flex-shrink: 0;
    display: block;
  }
</style>
