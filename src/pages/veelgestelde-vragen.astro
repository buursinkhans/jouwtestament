---
// /veelgestelde-vragen (docs/07): all FAQs grouped by topic, each with its own anchor.
import Layout from '../layouts/Layout.astro';
import Faq from '../components/content/Faq.astro';
import { faqGroups } from '../data/faq';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Veelgestelde vragen', url: '/veelgestelde-vragen' },
];
const allItems = faqGroups.flatMap((group) => group.items);
---

<Layout
  title="Veelgestelde vragen over je nalatenschap regelen"
  description="Antwoorden op veelgestelde vragen over advies, kosten, de notaris, je testament, het levenstestament, samenwonen en kinderen."
  pageKey="faq"
  breadcrumbs={breadcrumbs}
  faqItems={allItems}
>
  <div class="container page">
    <div class="section-head">
      <h1>Veelgestelde vragen</h1>
      <nav aria-label="Onderwerpen">
        <ul class="topics">
          {faqGroups.map((group) => <li><a href={`#${group.id}`}>{group.title}</a></li>)}
        </ul>
      </nav>
    </div>
    {faqGroups.map((group) => (
      <section id={group.id} class="group">
        <h2>{group.title}</h2>
        <Faq items={group.items} />
      </section>
    ))}
    <div class="btn-row cta">
      <a class="btn-primary" href="/check">Doe de gratis check (2 min)</a>
    </div>
  </div>
</Layout>

<style>
  .topics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 0;
    margin: 16px 0 0;
    font-weight: 600;
  }

  .group {
    margin-top: 56px;
  }

  .cta {
    margin-top: 56px;
  }
</style>
