---
// Home (docs/05, proposition updated 2026-09-28 on request of the owner). Prices from config/pricing.ts.
// TODO(review-partner): hero panel and risk cards 01–05.
import Layout from '../layouts/Layout.astro';
import SituationTile from '../components/content/SituationTile.astro';
import TipCard from '../components/content/TipCard.astro';
import DocumentCard from '../components/content/DocumentCard.astro';
import StepsAnimation from '../components/content/StepsAnimation.astro';
import PriceCard from '../components/content/PriceCard.astro';
import Faq from '../components/content/Faq.astro';
import Check from '../components/check/Check.astro';
import { Check as CheckIcon } from '@lucide/astro';
import { site, canShow } from '../config/site';
import { pricing, euro } from '../config/pricing';
import { situationTiles } from '../data/segments';
import { documents, priceCards, offerSchema } from '../data/offer';
import { homeFaq } from '../data/faq';

const description = `Wij helpen je je testament goed te regelen: je wensen helder op een rij, een instructie voor de notaris en een uitleg voor je nabestaanden. Zelf met onze assistent voor ${euro(pricing.selfService)}, of met een adviseur vanaf ${euro(pricing.advice.min)}.`;

// Why now, and why with help (owner 2026-09-28). TODO(review-partner)
const motivations = [
  {
    title: 'De wet kent jouw familie niet',
    text: 'Zonder testament bepaalt de wet wie erft. Een partner met wie je samenwoont en stiefkinderen krijgen dan niets.',
  },
  {
    title: 'Later kan het niet meer',
    text: 'Een testament maak je alleen als je zelf nog goed kunt beslissen. De notaris controleert dat. Nu regelen geeft rust.',
  },
  {
    title: 'Hulp voorkomt vergeten keuzes',
    text: 'Een standaardformulier regelt wat je invult, niet wat je vergeet. Met hulp komen de vragen aan bod waar je zelf niet aan dacht.',
  },
];

// The two routes (owner 2026-09-27): option 1 self-service, option 2 adviser
const routes = [
  {
    label: 'Zelf regelen',
    title: 'Met onze digitale assistent',
    price: euro(pricing.selfService),
    bullets: [
      'In je eigen tempo, wanneer het jou uitkomt',
      'De assistent legt de keuzes uit en zet je wensen op een rij',
      'Direct een instructie voor de notaris en een uitleg voor je nabestaanden',
    ],
    cta: { label: 'Start met de assistent', href: '/regel-het-zelf', primary: true },
  },
  {
    label: 'Met hulp',
    title: 'Met een adviseur',
    price: `vanaf ${euro(pricing.advice.min)}`,
    bullets: [
      'Voor een ingewikkelde situatie, of als je het liever niet zelf doet',
      'Een persoonlijk gesprek met een professional',
      'Dezelfde twee documenten, de prijs hoor je vooraf',
    ],
    cta: { label: 'Plan een gesprek', href: '/check#adviseur', primary: false },
  },
];

const heroPanel = [
  ['Samenwonend, niet getrouwd?', 'Je partner erft niets.'],
  ['Kinderen van je partner?', 'Stiefkinderen erven niets.'],
  ['Jonge kinderen?', 'Zonder regeling krijgen ze alles op hun 18e.'],
  ['Kun je zelf niet meer beslissen?', 'Rekeningen en je huis zitten vast tot de rechter iemand aanwijst.'],
];

const estateTiles = [
  { title: 'Je woning', text: 'Vaak het grootste deel. Wie mag erin blijven wonen?' },
  { title: 'Spaargeld en beleggingen', text: 'Wie krijgt wat, en wanneer?' },
  { title: 'Pensioen', text: 'Krijgt je partner een nabestaandenpensioen?' },
  { title: 'Verzekeringen', text: 'Wie is begunstigde, en weet je familie ervan?' },
];

const risks = [
  ['De woning', 'Zonder goede regeling kan je partner gedwongen worden het huis te verkopen, of kinderen uit te kopen.'],
  ['Erfbelasting', 'Samenwonenden zonder notarieel samenlevingscontract betalen vaak het hoogste tarief. Goede keuzes voorkomen onnodige belasting.'],
  ['Nabestaandenpensioen', 'Voor samenwoners geldt dit vaak alleen als je partner is aangemeld bij je pensioenfonds.'],
  ['Geblokkeerde rekeningen', 'Word je wilsonbekwaam, dan kan niemand zomaar bij je geld. Bewindvoering via de rechter kost tijd en geld.'],
  ['Trage afwikkeling', 'Zonder executeur moeten alle erfgenamen samen beslissen en tekenen. Dat vertraagt en kost vaak extra.'],
  ['Ruzie in de familie', 'Waar onduidelijkheid is, ontstaat discussie. Die kost niet alleen geld, maar ook relaties.'],
];

const stats = [
  ['€ 33,5 mld', 'nagelaten in 2023'],
  ['1 op 4', 'kreeg ruzie of onenigheid bij een erfenis'],
  ['8×', 'zo vaak geprocedeerd in 2015 als in 2003'],
  ['± 6 maanden', 'vertraging als zonder levenstestament eerst bewind nodig is'],
];

const homeTips = ['jonge-kinderen', 'ex-partner', 'executeur', 'transparant', 'uitsluitingsclausule', 'digitaal'];

const faq = homeFaq;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  description: site.entityDescription,
  slogan: site.tagline,
  areaServed: 'NL',
  makesOffer: offerSchema,
};
---

<Layout
  title="Regel je nalatenschap goed, voor iedereen"
  fullTitle="Helder Nalaten – Regel je nalatenschap goed, voor iedereen"
  description={description}
  faqItems={faq}
  schema={[serviceSchema]}
>
  <!-- 1. Hero: proposition + the two choices -->
  <section class="hero">
    <div class="container">
      <div class="hero-intro">
        <h1>Wij helpen je je testament goed te regelen</h1>
        <p class="lead">
          Je beantwoordt eenvoudige vragen, wij zetten je wensen helder op een rij. Je krijgt een instructie voor de
          notaris en een uitleg voor je nabestaanden. De notaris legt je testament vast.
        </p>
      </div>
      <div class="grid grid-2 routes">
        {routes.map((route) => (
          <article class="card route">
            <span class="eyebrow">{route.label}</span>
            <h2>{route.title}</h2>
            <p class="route-price">{route.price}</p>
            <ul>
              {route.bullets.map((bullet) => (
                <li><CheckIcon size={18} stroke-width={2} aria-hidden="true" />{bullet}</li>
              ))}
            </ul>
            <a class={route.cta.primary ? 'btn-primary' : 'btn-secondary'} href={route.cta.href}>{route.cta.label}</a>
          </article>
        ))}
      </div>
      <p class="hero-more">
        Twijfel je wat bij je past? <a href="/check">Doe eerst de gratis check (2 minuten)</a>
        <span class="trust"> · Vaste prijzen · Vrije keuze van notaris</span>
      </p>
    </div>
  </section>

  <!-- 1a. Why now, and why with help -->
  <section class="section section-surface" id="waarom-nu">
    <div class="container">
      <div class="section-head">
        <h2>Waarom nu regelen, en waarom met hulp?</h2>
      </div>
      <ol class="motivations">
        {motivations.map((item, index) => (
          <li>
            <span class="motivation-number" aria-hidden="true">{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 1b. What we arrange for you: the steps -->
  <section class="section" id="wat-we-regelen">
    <div class="container">
      <div class="section-head">
        <h2>Wat regelen we voor je?</h2>
        <p class="lead">Van de eerste vraag tot je testament bij de notaris. Jij kiest hoeveel hulp je wilt.</p>
      </div>
      <StepsAnimation id="stappen-home" />
      <p class="more small">
        Daarna leg je het testament vast bij een notaris uit ons netwerk voor {euro(pricing.willSingle)}{' '}
        ({euro(pricing.willCouple)} voor twee testamenten), of bij je eigen notaris met dezelfde instructie.
      </p>
    </div>
  </section>

  <!-- 2. Situation choice -->
  <section class="section" id="voor-wie">
    <div class="container">
      <div class="section-head">
        <h2>In welke situatie zit jij?</h2>
        <p class="lead">Wat je moet regelen, hangt af van je leven. Kies wat bij je past.</p>
      </div>
      <div class="grid grid-3">
        {situationTiles.map((tile) => <SituationTile {...tile} />)}
      </div>
    </div>
  </section>

  <!-- 3. Bigger than you think -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="section-head">
          <span class="eyebrow">Goed regelen is voor iedereen</span>
          <h2>Jouw nalatenschap is waarschijnlijk groter dan je denkt</h2>
          <p class="lead">
            Je hoeft geen vermogend te zijn om iets na te laten. Een koophuis, spaargeld, pensioen en een
            levensverzekering tellen samen al snel op. Hoe groter het bedrag, hoe belangrijker dat duidelijk is wie
            wat krijgt, en wie het regelt.
          </p>
        </div>
        <figure class="big-stat">
          <p class="number">€ 368.000</p>
          <p>
            erven kinderen van ouders met een koopwoning gemiddeld. Bij ouders met een huurwoning is dat € 18.000.
          </p>
          {/* TODO(owner): link the original source */}
          <figcaption class="source">Bron: berichtgeving op basis van CBS/ESB (2026)</figcaption>
        </figure>
      </div>
      <ul class="plain-list estate">
        {estateTiles.map(({ title, text }) => (
          <li>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. What is at stake -->
  <section class="section" id="waarom">
    <div class="container">
      <div class="section-head">
        <h2>Als jij het niet regelt, doet de wet het</h2>
        <p class="lead">
          De wet heeft een standaardregeling. Die past lang niet altijd bij hoe jij leeft. De gevolgen komen terecht
          bij de mensen die je juist wilt beschermen.
        </p>
      </div>
      <dl class="law-list">
        {heroPanel.map(([question, answer]) => (
          <div>
            <dt>{question}</dt>
            <dd>{answer}</dd>
          </div>
        ))}
      </dl>
      <ol class="plain-list risks">
        {risks.map(([title, text], index) => (
          <li>
            <h3><span class="risk-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <dl class="grid grid-4 stats">
        {stats.map(([number, label]) => (
          <div class="stat">
            <dt>{number}</dt>
            <dd>{label}</dd>
          </div>
        ))}
      </dl>
      {/* TODO(owner): link the original sources */}
      <p class="source">Bronnen: CBS (2023); RTL Nieuwspanel (2025); Rijksuniversiteit Groningen; KNB via NOS (2024).</p>
    </div>
  </section>

  <!-- 5. Tips -->
  <section class="section" id="tips">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Waar bijna niemand aan denkt</span>
        <h2>Zes dingen die je beter nu kunt regelen dan later</h2>
        <p class="lead">
          Een goed testament gaat niet alleen over wie wat krijgt, maar ook over wanneer, door wie en hoe.
        </p>
      </div>
      <div class="grid grid-3">
        {homeTips.map((slug) => <TipCard slug={slug} />)}
      </div>
      <p class="more"><a class="btn-secondary" href="/tips">Lees alle tips</a></p>
    </div>
  </section>

  <!-- 6. What you get -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Wat je krijgt: twee heldere documenten</h2>
        <p class="lead">
          Of je nu met de assistent of met een adviseur werkt, je krijgt dezelfde twee documenten. Daarna regel je het
          testament bij een notaris naar keuze.
        </p>
      </div>
      <div class="grid grid-2">
        {documents.map((doc) => (
          <DocumentCard number={doc.number} title={doc.title} bullets={doc.bullets.slice(0, 2)} />
        ))}
      </div>
      <p class="more"><a class="link-arrow" href="/hoe-het-werkt">Zo werkt het precies →</a></p>
    </div>
  </section>

  <!-- 7. Prices -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Helder geprijsd. Vooraf weet je waar je aan toe bent.</h2>
      </div>
      <div class="grid grid-4">
        {priceCards.map((card) => <PriceCard {...card} />)}
      </div>
      <p class="more">Liever je eigen notaris? Dat kan. Je krijgt dezelfde instructie mee.</p>
      <p><a class="link-arrow" href="/tarieven">Alle tarieven en rekenvoorbeelden →</a></p>
    </div>
  </section>

  <!-- 8. Check -->
  <section class="section check-section">
    <div class="container">
      <Check segmentPage="home" />
    </div>
  </section>

  <!-- 9. For everyone -->
  <section class="section">
    <div class="container narrow">
      <h2>Goed regelen hoeft niet ingewikkeld of duur te zijn.</h2>
      <p class="lead">
        Helder Nalaten is er voor iedereen. We stellen de vragen die je zelf misschien liever overslaat, leggen de
        keuzes eerlijk naast elkaar en zeggen het ook als iets voor jou niet nodig is. We werken samen met
        notarissen door het hele land, maar je bent vrij om je eigen notaris te kiezen.
      </p>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="section" id="veelgestelde-vragen">
    <div class="container">
      <div class="section-head">
        <h2>Veelgestelde vragen</h2>
      </div>
      <Faq items={faq} />
      <p class="more"><a class="link-arrow" href="/veelgestelde-vragen">Alle veelgestelde vragen →</a></p>
    </div>
  </section>

  <!-- 11. Closing -->
  <section class="section">
    <div class="container narrow closing">
      <h2>Regel het nu, voor de mensen van wie je houdt.</h2>
      <p class="lead">
        {canShow(site.contact.phone) ? (
          <>Doe de gratis check van twee minuten, of bel <span class="placeholder">{site.contact.phone}</span>.</>
        ) : (
          <>Doe de gratis check van twee minuten.</>
        )}
      </p>
      <a class="btn-primary" href="/check">Doe de gratis check</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 40px 0 56px;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 64px 0 72px;
    }
  }

  .hero-intro {
    max-width: 760px;
  }

  .hero .lead {
    margin: 16px 0 0;
  }

  .hero-more {
    margin: 24px 0 0;
    font-size: var(--fs-small);
  }

  .trust {
    color: var(--color-muted);
  }

  .route ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .route li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .route li :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--color-primary);
  }

  .route h2 {
    font-size: var(--fs-h3);
    margin: 0;
  }

  .motivations {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .motivations {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .motivation-number {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-tint);
    color: var(--color-primary);
    font-weight: 700;
    font-size: var(--fs-small);
    margin-bottom: 12px;
  }

  .motivations h3 {
    margin-bottom: 6px;
  }

  .motivations p {
    margin: 0;
  }

  .routes {
    margin-top: 32px;
  }

  .route {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .route h3 {
    margin: 0;
  }

  .route-price {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .route ul {
    gap: 10px;
    margin-bottom: 8px;
    flex-grow: 1;
  }

  .route .btn-primary,
  .route .btn-secondary {
    align-self: flex-start;
  }

  .law-list {
    display: grid;
    gap: 12px 32px;
    margin: 0 0 40px;
  }

  @media (min-width: 768px) {
    .law-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .law-list div {
    border-left: 0;
    background: var(--color-ground);
    border-radius: var(--radius-small);
    padding: 14px 18px;
  }

  .law-list dt {
    color: var(--color-muted);
    font-size: var(--fs-small);
  }

  .law-list dd {
    margin: 0;
    font-weight: 600;
  }

  .split {
    display: grid;
    gap: 32px;
    margin-bottom: 40px;
  }

  @media (min-width: 1024px) {
    .split {
      grid-template-columns: 3fr 2fr;
      align-items: end;
    }
  }

  .split .section-head {
    margin-bottom: 0;
  }

  .big-stat {
    margin: 0;
    border-left: 0;
    padding: 0;
  }

  .number {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
    margin: 0 0 4px;
  }

  .plain-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px 48px;
  }

  @media (min-width: 768px) {
    .plain-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .plain-list li {
    border-top: 1px solid var(--color-border);
    padding: 20px 0 8px;
  }

  .plain-list h3 {
    font-size: var(--fs-body);
    margin-bottom: 4px;
  }

  .plain-list p {
    margin: 0;
  }

  .risk-number {
    color: var(--color-muted);
    font-weight: 600;
    margin-right: 10px;
  }

  .risks {
    margin-bottom: 40px;
  }

  .stats {
    margin: 0 0 12px;
  }

  .stat {
    border-top: 1px solid var(--color-border);
    padding-top: 16px;
  }

  .stat dt {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat dd {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  .more {
    margin-top: 28px;
  }

  .documents {
    margin-top: 40px;
  }

  .closing {
    text-align: center;
  }

  .closing .lead {
    margin-bottom: 24px;
  }
</style>
