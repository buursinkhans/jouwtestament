---
// Home (docs/05). Copy verbatim; prices from config/pricing.ts.
// TODO(review-partner): hero panel and risk cards 01–05.
import Layout from '../layouts/Layout.astro';
import SituationTile from '../components/content/SituationTile.astro';
import TipCard from '../components/content/TipCard.astro';
import DocumentCard from '../components/content/DocumentCard.astro';
import PriceCard from '../components/content/PriceCard.astro';
import Faq from '../components/content/Faq.astro';
import Check from '../components/check/Check.astro';
import { site, canShow } from '../config/site';
import { pricing, euro } from '../config/pricing';
import { situationTiles } from '../data/segments';
import { documents, priceCards, offerSchema } from '../data/offer';
import { homeFaq } from '../data/faq';

const description = `Als jij het niet regelt, doet de wet het. Regel het nu, voor de mensen van wie je houdt: financieel advies vanaf ${euro(pricing.advice.min)}, testament vanaf ${euro(pricing.willSingle)}, vaste prijzen en vrije keuze van notaris.`;

const heroPanel = [
  ['Samenwonend, niet getrouwd?', 'Je partner erft niets.'],
  ['Kinderen van je partner?', 'Stiefkinderen erven niets.'],
  ['Jonge kinderen?', 'Zonder regeling krijgen ze alles op hun 18e.'],
  ['Kun je zelf niet meer beslissen?', 'Rekeningen en je huis zitten vast tot de rechter iemand aanwijst.'],
];

const estateTiles = [
  { title: 'Je woning', text: 'Vaak het grootste deel. Wie mag erin blijven wonen?' },
  { title: 'Spaargeld en beleggingen', text: 'Wie krijgt wat, en wanneer?' },
  { title: 'Pensioen', text: 'Krijgt je partner een nabestaandenpensioen?' },
  { title: 'Verzekeringen', text: 'Wie is begunstigde, en weet je familie ervan?' },
];

const risks = [
  ['De woning', 'Zonder goede regeling kan je partner gedwongen worden het huis te verkopen, of kinderen uit te kopen.'],
  ['Erfbelasting', 'Samenwonenden zonder notarieel samenlevingscontract betalen vaak het hoogste tarief. Goede keuzes voorkomen onnodige belasting.'],
  ['Nabestaandenpensioen', 'Voor samenwoners geldt dit vaak alleen als je partner is aangemeld bij je pensioenfonds.'],
  ['Geblokkeerde rekeningen', 'Word je wilsonbekwaam, dan kan niemand zomaar bij je geld. Bewindvoering via de rechter kost tijd en geld.'],
  ['Trage afwikkeling', 'Zonder executeur moeten alle erfgenamen samen beslissen en tekenen. Dat vertraagt en kost vaak extra.'],
  ['Ruzie in de familie', 'Waar onduidelijkheid is, ontstaat discussie. Die kost niet alleen geld, maar ook relaties.'],
];

const stats = [
  ['€ 33,5 mld', 'nagelaten in 2023'],
  ['1 op 4', 'kreeg ruzie of onenigheid bij een erfenis'],
  ['8×', 'zo vaak geprocedeerd in 2015 als in 2003'],
  ['± 6 maanden', 'vertraging als zonder levenstestament eerst bewind nodig is'],
];

const homeTips = ['jonge-kinderen', 'ex-partner', 'executeur', 'transparant', 'uitsluitingsclausule', 'digitaal'];

const faq = homeFaq;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: site.url,
  description: site.entityDescription,
  slogan: site.tagline,
  areaServed: 'NL',
  makesOffer: offerSchema,
};
---

<Layout
  title="Regel je nalatenschap goed, voor iedereen"
  fullTitle="Helder Nalaten – Regel je nalatenschap goed, voor iedereen"
  description={description}
  faqItems={faq}
  schema={[serviceSchema]}
>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Regel het nu, voor de mensen van wie je houdt</span>
        <h1>Als jij het niet regelt, doet de wet het. En die kent jouw familie niet.</h1>
        <p class="lead">
          Helder Nalaten helpt je je nalatenschap goed te regelen. Een adviseur zet op een rij wat er voor jou
          geregeld moet worden. Je testament is het resultaat. Laagdrempelig, met vaste prijzen.
        </p>
        <div class="btn-row">
          <a class="btn-primary" href="/check">Doe de gratis check (2 minuten)</a>
          <a class="btn-secondary" href="/tarieven">Bekijk de tarieven</a>
        </div>
        <p class="trust">Voor iedereen · Vaste prijzen · Vrije keuze van notaris</p>
      </div>
      <aside class="hero-panel" aria-labelledby="hero-panel-title">
        <h2 id="hero-panel-title">Zonder regeling beslist de wet</h2>
        <dl>
          {heroPanel.map(([question, answer]) => (
            <div>
              <dt>{question}</dt>
              <dd>{answer}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <!-- 2. Situation choice -->
  <section class="section" id="voor-wie">
    <div class="container">
      <div class="section-head">
        <h2>In welke situatie zit jij?</h2>
        <p class="lead">Wat je moet regelen, hangt af van je leven. Kies wat bij je past.</p>
      </div>
      <div class="grid grid-3">
        {situationTiles.map((tile) => <SituationTile {...tile} />)}
      </div>
    </div>
  </section>

  <!-- 3. Bigger than you think -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="section-head">
          <span class="eyebrow">Goed regelen is voor iedereen</span>
          <h2>Jouw nalatenschap is waarschijnlijk groter dan je denkt</h2>
          <p class="lead">
            Je hoeft geen vermogend te zijn om iets na te laten. Een koophuis, spaargeld, pensioen en een
            levensverzekering tellen samen al snel op. Hoe groter het bedrag, hoe belangrijker dat duidelijk is wie
            wat krijgt, en wie het regelt.
          </p>
        </div>
        <figure class="big-stat">
          <p class="number">€ 368.000</p>
          <p>
            erven kinderen van ouders met een koopwoning gemiddeld. Bij ouders met een huurwoning is dat € 18.000.
          </p>
          {/* TODO(owner): link the original source */}
          <figcaption class="source">Bron: berichtgeving op basis van CBS/ESB (2026)</figcaption>
        </figure>
      </div>
      <ul class="plain-list estate">
        {estateTiles.map(({ title, text }) => (
          <li>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. What is at stake -->
  <section class="section" id="waarom">
    <div class="container">
      <div class="section-head">
        <h2>Wat gebeurt er als je niets regelt?</h2>
        <p class="lead">
          De wet heeft een standaardregeling. Die past lang niet altijd bij hoe jij leeft. De gevolgen komen terecht
          bij de mensen die je juist wilt beschermen.
        </p>
      </div>
      <ol class="plain-list risks">
        {risks.map(([title, text], index) => (
          <li>
            <h3><span class="risk-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <dl class="grid grid-4 stats">
        {stats.map(([number, label]) => (
          <div class="stat">
            <dt>{number}</dt>
            <dd>{label}</dd>
          </div>
        ))}
      </dl>
      {/* TODO(owner): link the original sources */}
      <p class="source">Bronnen: CBS (2023); RTL Nieuwspanel (2025); Rijksuniversiteit Groningen; KNB via NOS (2024).</p>
    </div>
  </section>

  <!-- 5. Tips -->
  <section class="section" id="tips">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Waar bijna niemand aan denkt</span>
        <h2>Zes dingen die je beter nu kunt regelen dan later</h2>
        <p class="lead">
          Een goed testament gaat niet alleen over wie wat krijgt, maar ook over wanneer, door wie en hoe.
        </p>
      </div>
      <div class="grid grid-3">
        {homeTips.map((slug) => <TipCard slug={slug} />)}
      </div>
      <p class="more"><a class="btn-secondary" href="/tips">Lees alle tips</a></p>
    </div>
  </section>

  <!-- 6. What you get -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Financieel advies over je nalatenschap</span>
        <h2>Eén gesprek. Twee heldere documenten. Je testament als resultaat.</h2>
        <p class="lead">
          Een adviseur brengt je situatie in kaart en adviseert over de beste keuzes. Daarna regel je het
          testament bij een notaris naar keuze.
        </p>
      </div>
      <div class="grid grid-2">
        {documents.map((doc) => (
          <DocumentCard number={doc.number} title={doc.title} bullets={doc.bullets.slice(0, 2)} />
        ))}
      </div>
      <p class="more"><a class="link-arrow" href="/hoe-het-werkt">Zo werkt het precies →</a></p>
    </div>
  </section>

  <!-- 7. Prices -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Helder geprijsd. Vooraf weet je waar je aan toe bent.</h2>
      </div>
      <div class="grid grid-3">
        {priceCards.map((card) => <PriceCard {...card} />)}
      </div>
      <p class="more">Liever je eigen notaris? Dat kan. Je krijgt dezelfde instructie mee.</p>
      <p><a class="link-arrow" href="/tarieven">Alle tarieven en rekenvoorbeelden →</a></p>
    </div>
  </section>

  <!-- 8. Check -->
  <section class="section check-section">
    <div class="container">
      <Check segmentPage="home" />
    </div>
  </section>

  <!-- 9. For everyone -->
  <section class="section">
    <div class="container narrow">
      <h2>Goed regelen hoeft niet ingewikkeld of duur te zijn.</h2>
      <p class="lead">
        Helder Nalaten is er voor iedereen. We stellen de vragen die je zelf misschien liever overslaat, leggen de
        keuzes eerlijk naast elkaar en zeggen het ook als iets voor jou niet nodig is. We werken samen met
        notarissen door het hele land, maar je bent vrij om je eigen notaris te kiezen.
      </p>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="section" id="veelgestelde-vragen">
    <div class="container">
      <div class="section-head">
        <h2>Veelgestelde vragen</h2>
      </div>
      <Faq items={faq} />
      <p class="more"><a class="link-arrow" href="/veelgestelde-vragen">Alle veelgestelde vragen →</a></p>
    </div>
  </section>

  <!-- 11. Closing -->
  <section class="section">
    <div class="container narrow closing">
      <h2>Regel het nu, voor de mensen van wie je houdt.</h2>
      <p class="lead">
        {canShow(site.contact.phone) ? (
          <>Doe de gratis check van twee minuten, of bel <span class="placeholder">{site.contact.phone}</span>.</>
        ) : (
          <>Doe de gratis check van twee minuten.</>
        )}
      </p>
      <a class="btn-primary" href="/check">Doe de gratis check</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 40px 0 var(--section-pad);
  }

  .hero-grid {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: 72px;
    }
    .hero-grid {
      grid-template-columns: 7fr 5fr;
      gap: 64px;
    }
  }

  .hero .lead {
    margin: 20px 0 28px;
  }

  .trust {
    margin-top: 20px;
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  .hero-panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 28px;
  }

  .hero-panel h2 {
    font-size: var(--fs-h3);
    margin-bottom: 8px;
  }

  .hero-panel dl {
    margin: 0;
  }

  .hero-panel div {
    border-top: 1px solid var(--color-border);
    padding: 12px 0;
  }

  .hero-panel div:last-child {
    padding-bottom: 0;
  }

  .hero-panel dt {
    color: var(--color-muted);
  }

  .hero-panel dd {
    margin: 0;
    font-weight: 600;
  }

  .split {
    display: grid;
    gap: 32px;
    margin-bottom: 40px;
  }

  @media (min-width: 1024px) {
    .split {
      grid-template-columns: 3fr 2fr;
      align-items: end;
    }
  }

  .split .section-head {
    margin-bottom: 0;
  }

  .big-stat {
    margin: 0;
    border-left: 0;
    padding: 0;
  }

  .number {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
    margin: 0 0 4px;
  }

  .plain-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px 48px;
  }

  @media (min-width: 768px) {
    .plain-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .plain-list li {
    border-top: 1px solid var(--color-border);
    padding: 20px 0 8px;
  }

  .plain-list h3 {
    font-size: var(--fs-body);
    margin-bottom: 4px;
  }

  .plain-list p {
    margin: 0;
  }

  .risk-number {
    color: var(--color-muted);
    font-weight: 600;
    margin-right: 10px;
  }

  .risks {
    margin-bottom: 40px;
  }

  .stats {
    margin: 0 0 12px;
  }

  .stat {
    border-top: 1px solid var(--color-border);
    padding-top: 16px;
  }

  .stat dt {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat dd {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--color-muted);
  }

  .more {
    margin-top: 28px;
  }

  .closing {
    text-align: center;
  }

  .closing .lead {
    margin-bottom: 24px;
  }
</style>
