---
// /over-ons (docs/07). Placeholders until the owner provides the texts.
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Over ons', url: '/over-ons' },
];
---

<Layout
  title="Wie zijn wij?"
  description={site.entityDescription}
  breadcrumbs={breadcrumbs}
  schema={[{ '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Over ons', inLanguage: 'nl-NL' }]}
>
  <div class="container narrow page prose">
    <h1>Wie zijn wij?</h1>
    <p><span class="placeholder">[Waarom Helder Nalaten bestaat — 2 alinea's, eigenaar]</span></p>
    <p class="lead">{site.entityDescription}</p>

    <section id="adviseurs">
      <h2>Onze adviseurs</h2>
      {/* TODO(owner): per adviser name, photo, qualifications, experience, Person schema with sameAs (LinkedIn) */}
      <div id={site.reviewer.anchor}>
        <p><span class="placeholder">[NAAM, FOTO, KWALIFICATIES, ERVARING]</span></p>
      </div>
    </section>

    <section id="notarisnetwerk">
      <h2>Notarisnetwerk</h2>
      <p>
        <span class="placeholder">[Hoe het werkt, [aantal] notarissen in [regio's]]</span> Je bent vrij om je eigen
        notaris te kiezen.
      </p>
    </section>

    <section id="transparantie">
      <h2>Hoe we verdienen</h2>
      {/* TODO(owner): agree this text with the partner */}
      <p><span class="placeholder">[Hoe we verdienen, af te stemmen met partner]</span></p>
    </section>

    {/* Owner decision: no address on the site (only KvK and contact) */}
    <section id="bedrijfsgegevens">
      <h2>Bedrijfsgegevens</h2>
      <ul>
        <li>KvK: <span class="placeholder">{site.kvk}</span></li>
        <li>Telefoon: <span class="placeholder">{site.contact.phone}</span></li>
        <li>E-mail: <span class="placeholder">{site.contact.email}</span></li>
      </ul>
    </section>

    <div class="btn-row">
      <a class="btn-primary" href="/check">Doe de gratis check (2 min)</a>
    </div>
  </div>
</Layout>
