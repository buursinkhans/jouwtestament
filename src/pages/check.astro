---
// /check: the check as a standalone page (docs/09). URL parameters prefill answers.
import Layout from '../layouts/Layout.astro';
import Check from '../components/check/Check.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gratis check', url: '/check' },
];
---

<Layout
  title="Gratis nalatenschapscheck: hoe staat jouw regeling ervoor?"
  description="Beantwoord een paar vragen en zie direct waar je op moet letten. Daarna kies je: zelf regelen met onze assistent, of een gesprek met een adviseur."
  breadcrumbs={breadcrumbs}
  hideStickyCta
>
  <div class="container page">
    <Check isPageTitle />
  </div>
</Layout>

<style>
  .page {
    padding-top: 8px;
  }
</style>
