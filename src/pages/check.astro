---
// /check: the check as a standalone page (docs/09). URL parameters prefill answers.
import Layout from '../layouts/Layout.astro';
import Check from '../components/check/Check.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gratis check', url: '/check' },
];
---

<Layout
  title="Gratis nalatenschapscheck en gespreksagenda"
  description="Maak gratis een gespreksagenda voor thuis en voor de notaris. Bereid je eigen nalatenschap voor of begin het gesprek met je ouders."
  breadcrumbs={breadcrumbs}
  hideStickyCta
>
  <div class="container page">
    <Check isPageTitle />
  </div>
</Layout>

<style>
  .page {
    padding-top: 8px;
  }
</style>
