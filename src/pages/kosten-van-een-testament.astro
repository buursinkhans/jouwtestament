---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { Info, ScrollText, ShieldCheck, CircleQuestionMark, Clock, BadgePercent, CircleCheck } from '@lucide/astro';
import { pricing, priceForTwo } from '../data/pricing';

const lang = 'nl' as const;
const t = useTranslations(lang);

const included = [
  'Voorbereiding met het stappenplan',
  'Controle door de notaris',
  'Opmaken en ondertekenen van de akte',
  'Inschrijving in het officiële register',
];

const faqItems = [
  {
    question: 'Betaal ik vooraf?',
    answer: 'Ja, je betaalt het volledige bedrag vooraf. Daarna plannen we je afspraak bij de notaris in.',
  },
  {
    question: 'Wat garanderen jullie precies?',
    answer: `We garanderen dat je binnen ${pricing.guaranteeWeeks} weken na betaling bij de notaris zit voor de ondertekening.`,
  },
  {
    question: 'Zit de inschrijving in het officiële register bij de prijs inbegrepen?',
    answer: 'Ja, dat zit bij de prijs inbegrepen.',
  },
];
---

<Layout
  title="Wat kost een testament of levenstestament?"
  description={`Eén vast bedrag van €${pricing.pricePerDocument} per document. Je betaalt vooraf, met garantie dat je binnen ${pricing.guaranteeWeeks} weken bij de notaris zit.`}
  pageKey="kosten"
  datePublished="2026-09-20"
  dateModified="2026-09-21"
  faqItems={faqItems}
>
  <article>
    <h1>Wat kost een testament of levenstestament?</h1>

    <p class="lead">
      Eén vast bedrag, geen verrassingen achteraf. Je betaalt vooraf, en we
      garanderen dat je binnen {pricing.guaranteeWeeks} weken bij de notaris zit.
    </p>

    <div class="disclaimer-box">
      <Info size={20} stroke-width={1.75} />
      <p>{t('disclaimer.short')}</p>
    </div>

    <div class="price-grid">
      <div class="price-card">
        <p class="price-card-label">1 document</p>
        <p class="price-amount">&euro;{pricing.pricePerDocument}</p>
        <p class="price-card-sub">Testament of levenstestament</p>
        <ul class="price-features">
          {included.map((item) => (
            <li><CircleCheck size={18} stroke-width={1.75} aria-hidden="true" /> {item}</li>
          ))}
        </ul>
        <a class="button" href="/testament#funnel-testament">Start het stappenplan</a>
      </div>

      <div class="price-card price-card-highlight">
        <p class="price-card-badge"><BadgePercent size={16} stroke-width={1.75} aria-hidden="true" /> Samen voordeliger</p>
        <p class="price-card-label">2 documenten, samen met je partner</p>
        <p class="price-amount">&euro;{priceForTwo}</p>
        <p class="price-card-sub">
          In plaats van &euro;{pricing.pricePerDocument * 2} &mdash; je bespaart &euro;{pricing.coupleDiscount}
        </p>
        <ul class="price-features">
          {included.map((item) => (
            <li><CircleCheck size={18} stroke-width={1.75} aria-hidden="true" /> {item}</li>
          ))}
        </ul>
        <a class="button" href="/testament#funnel-testament">Start het stappenplan</a>
      </div>
    </div>

    <div class="guarantee-box">
      <Clock size={28} stroke-width={1.5} aria-hidden="true" class="guarantee-icon" />
      <div>
        <p class="guarantee-title">Garantie: binnen {pricing.guaranteeWeeks} weken bij de notaris</p>
        <p>Je betaalt vooraf, en wij zorgen dat je afspraak binnen {pricing.guaranteeWeeks} weken gepland staat.</p>
      </div>
    </div>

    <h2>{t('related.heading')}</h2>
    <div class="card-grid">
      <div class="card">
        <ScrollText class="card-icon" size={28} stroke-width={1.5} aria-hidden="true" />
        <h3>Testament</h3>
        <p>Alles wat je in een testament kunt regelen, op een rij.</p>
        <a href="/testament">Lees meer &rarr;</a>
      </div>
      <div class="card">
        <ShieldCheck class="card-icon" size={28} stroke-width={1.5} aria-hidden="true" />
        <h3>Levenstestament</h3>
        <p>Regel wie voor je beslist als je dat zelf niet meer kunt.</p>
        <a href="/levenstestament">Lees meer &rarr;</a>
      </div>
    </div>

    <h2><CircleQuestionMark class="heading-icon" size={22} stroke-width={1.75} aria-hidden="true" />{t('faq.heading')}</h2>
    <dl>
      {faqItems.map((item) => (
        <div class="faq-item">
          <dt>{item.question}</dt>
          <dd>{item.answer}</dd>
        </div>
      ))}
    </dl>
    <p><a href="/veelgestelde-vragen">{t('cta.view_all_faq')} &rarr;</a></p>

    <h2>{t('sources.heading')}</h2>
    <ul>
      <li><a href="https://www.rijksoverheid.nl">Rijksoverheid</a> &mdash; informatie over het Centraal Testamentenregister</li>
    </ul>
    <p class="meta-line">Deze bron is geraadpleegd in 2026.</p>

    <p class="meta-line">{t('lastchecked.label')}: 21 september 2026</p>

    <p class="cta-row">
      <a class="button" href="/testament#funnel-testament">Start het stappenplan</a>
      <a class="button-secondary" href="/">{t('cta.back_home')}</a>
    </p>
  </article>
</Layout>

<style>
  .price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin: 1.75rem 0;
  }

  .price-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 0.9rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .price-card-highlight {
    border: 2px solid var(--color-accent);
    position: relative;
  }

  .price-card-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin: 0 0 0.85rem;
  }

  .price-card-label {
    font-weight: 700;
    margin: 0;
    color: var(--color-text);
  }

  .price-amount {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0.2rem 0;
  }

  .price-card-sub {
    color: var(--color-muted);
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
  }

  .price-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.5rem;
  }

  .price-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .price-features svg {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .price-card .button {
    margin-top: auto;
    text-align: center;
  }

  .guarantee-box {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--color-secondary);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.75rem;
  }

  .guarantee-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .guarantee-title {
    font-weight: 700;
    margin: 0 0 0.25rem;
    color: var(--color-primary);
  }

  .guarantee-box p:last-child {
    margin: 0;
  }
</style>
