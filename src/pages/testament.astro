---
// /testament (docs/07): landing page for jouwtestament.nl (utm_source=jouwtestament).
import Layout from '../layouts/Layout.astro';
import ShortAnswer from '../components/content/ShortAnswer.astro';
import ReviewMeta from '../components/content/ReviewMeta.astro';
import PriceCard from '../components/content/PriceCard.astro';
import Steps from '../components/content/Steps.astro';
import TipCard from '../components/content/TipCard.astro';
import Faq from '../components/content/Faq.astro';
import Check from '../components/check/Check.astro';
import { pricing, euro } from '../config/pricing';
import { priceCards, steps, offerSchema } from '../data/offer';
import { testamentFaq } from '../data/faq';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Testament', url: '/testament' },
];

const faq = testamentFaq;

const regelen = [
  'Wie erft en wie niet',
  'Wie de afwikkeling regelt (executeur)',
  'Wie voor je kinderen zorgt (voogd) en wie hun geld beheert',
  'Tot welke leeftijd kinderen moeten wachten',
  'Bescherming van je partner',
  'Uitsluitingsclausule',
];
---

<Layout
  title="Een testament dat echt bij jouw leven past"
  fullTitle={`Testament laten opstellen vanaf ${euro(pricing.willSingle)}, met helder advies | Helder Nalaten`}
  description={`Een testament dat echt bij je leven past. Eerst helder advies over wat je moet regelen, daarna je testament bij een netwerknotaris voor ${euro(pricing.willSingle)}, of ${euro(pricing.willCouple)} voor partners.`}
  breadcrumbs={breadcrumbs}
  faqItems={faq}
  schema={[{ '@context': 'https://schema.org', '@type': 'WebPage', name: 'Testament', inLanguage: 'nl-NL', offers: offerSchema }]}
>
  <div class="container narrow">
    <h1>Een testament dat echt bij jouw leven past</h1>
    <ReviewMeta />
    <ShortAnswer>
      <p>
        Een testament is het resultaat van goede keuzes. Daarom begint het bij ons met advies: wat moet er voor jou
        geregeld worden, en wat niet? Daarna leg je het testament vast bij een netwerknotaris voor
        {' '}{euro(pricing.willSingle)} ({euro(pricing.willCouple)} voor partners) of bij je eigen notaris.
      </p>
    </ShortAnswer>

    <div class="prose">
      <section id="wat-regel-je">
        <h2>Wat regel je in een testament?</h2>
        <ul>{regelen.map((item) => <li>{item}</li>)}</ul>
      </section>
      <section id="waarom-advies">
        <h2>Waarom eerst advies?</h2>
        <p>
          Een testament uit een standaardformulier regelt wat je invult, niet wat je vergeet. In het adviesgesprek
          komen de vragen aan bod die je zelf niet had bedacht.
        </p>
      </section>
    </div>
  </div>

  <section class="section" id="prijzen">
    <div class="container">
      <h2>Prijzen</h2>
      <div class="grid grid-4">{priceCards.map((card) => <PriceCard {...card} />)}</div>
      <p class="more"><a class="link-arrow" href="/tarieven">Alle tarieven →</a></p>
    </div>
  </section>

  <section class="section section-surface" id="stappen">
    <div class="container narrow">
      <h2>Zo werkt het</h2>
      <Steps steps={steps} />
      <p class="more"><a class="link-arrow" href="/hoe-het-werkt">Zo werkt het precies →</a></p>
    </div>
  </section>

  <section class="section" id="tips">
    <div class="container">
      <h2>Tips</h2>
      <div class="grid grid-3">
        {['executeur', 'jonge-kinderen', 'actueel'].map((slug) => <TipCard slug={slug} />)}
      </div>
    </div>
  </section>

  <div class="container">
    <Check segmentPage="testament" />
  </div>

  <section class="section" id="veelgestelde-vragen">
    <div class="container">
      <h2>Veelgestelde vragen</h2>
      <Faq items={faq} />
    </div>
  </section>
</Layout>

<style>
  h2 {
    margin-bottom: 32px;
  }

  .prose h2 {
    margin-bottom: 0.5em;
  }

  .more {
    margin-top: 28px;
  }
</style>
