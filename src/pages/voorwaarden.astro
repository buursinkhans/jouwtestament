---
// /voorwaarden. TODO(owner): terms must be written and reviewed. Not linked on the live site until then.
import Layout from '../layouts/Layout.astro';
import { devOnly } from '../config/site';
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Voorwaarden', url: '/voorwaarden' },
];
---

<Layout title="Voorwaarden" description="De voorwaarden van Helder Nalaten." breadcrumbs={breadcrumbs} noindex={!devOnly}>
  <div class="container narrow page">
    <h1>Voorwaarden</h1>
    {devOnly ? <p><span class="placeholder">[VOORWAARDEN]</span></p> : <p>Onze voorwaarden volgen binnenkort.</p>}
  </div>
</Layout>
