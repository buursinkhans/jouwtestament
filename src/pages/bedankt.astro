---
// /bedankt: after sending the check (also the no-JS fallback, docs/03, docs/10).
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Bedankt voor je aanvraag"
  description="We nemen binnen 24 uur contact met je op."
  hideStickyCta
  noindex
>
  <div class="container narrow page">
    <h1>Bedankt!</h1>
    <p class="lead">We nemen binnen 24 uur contact met je op om de afspraak definitief te maken.</p>
    <div class="btn-row">
      <a class="btn-primary" href="/tips">Lees alvast de tips</a>
      <a class="btn-secondary" href="/hoe-het-werkt">Zo werkt het</a>
    </div>
  </div>
</Layout>
