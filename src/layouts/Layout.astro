---
// Base layout: head/SEO, header, breadcrumbs, sticky CTA, footer (docs/03, docs/04, docs/11).
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import StickyCta from '../components/layout/StickyCta.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Analytics from '../components/layout/Analytics.astro';
import { site } from '../config/site';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  fullTitle?: string; // complete <title>, without the automatic "| Helder Nalaten" suffix
  breadcrumbs?: { name: string; url: string }[]; // incl. Home; shown on every page except home
  faqItems?: FaqItem[]; // FAQPage schema
  datePublished?: string;
  dateModified?: string;
  schema?: Record<string, unknown>[]; // extra JSON-LD blocks
  hideStickyCta?: boolean; // on /check and /bedankt
  noindex?: boolean;
}

const {
  title,
  description,
  fullTitle,
  breadcrumbs,
  faqItems,
  datePublished,
  dateModified,
  schema = [],
  hideStickyCta = false,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  slogan: site.tagline,
  description: site.entityDescription,
  // TODO(owner): add logo, contactPoint and sameAs once confirmed
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: 'nl-NL',
};

const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: new URL(item.url, Astro.site).toString(),
        })),
      }
    : null;

const faqSchema =
  faqItems && faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const articleSchema = datePublished
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      inLanguage: 'nl-NL',
      datePublished,
      dateModified: dateModified ?? datePublished,
      description,
      publisher: { '@type': 'Organization', name: site.name },
    }
  : null;

const jsonLd = [organizationSchema, websiteSchema, breadcrumbSchema, faqSchema, articleSchema, ...schema].filter(
  Boolean
);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle ?? `${title} | ${site.name}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Naar de inhoud</a>
    <Header />
    <main id="main">
      {breadcrumbs && breadcrumbs.length > 1 && (
        <div class="container breadcrumb-bar">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      )}
      <slot />
    </main>
    <Footer />
    {!hideStickyCta && <StickyCta />}
  </body>
</html>

<style>
  .breadcrumb-bar {
    padding-top: 24px;
  }
</style>
